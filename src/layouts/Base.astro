---
import '~/styles/global.css';
import SeoHead from '~/components/SeoHead.astro';
import Schema from '~/components/Schema.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import type { FaqItem } from '~/types';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  image?: string;
  /** Ohne Startseite, die wird im Markup automatisch vorangestellt. */
  breadcrumbs?: Array<{ label: string; href?: string }>;
  service?: { name: string; description: string };
  faq?: FaqItem[];
  /**
   * Farbe der Kopftafel dieser Seite. Die Kopfleiste übernimmt sie, damit die
   * Seite nicht mit einem weißen Streifen über der Tafel beginnt. Seiten ohne
   * farbige Tafel lassen die Angabe weg.
   */
  kopfFarbe?: string;
}

const {
  title,
  description,
  noindex,
  image,
  breadcrumbs,
  service,
  faq,
  kopfFarbe,
}: Props = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <SeoHead
      title={title}
      description={description}
      noindex={noindex}
      image={image}
      kopfFarbe={kopfFarbe}
    />
    {!noindex && <Schema breadcrumbs={breadcrumbs} service={service} faq={faq} />}
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-100 focus:rounded-button focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-contrast"
    >
      Zum Inhalt springen
    </a>

    <Header kopfFarbe={kopfFarbe} />

    <main id="inhalt">
      <slot />
    </main>

    <Footer />

    {/*
      Das eigene Element für die einlaufenden Kennungen. Steht bewusst HIER
      und nicht in `Scramble.astro`: die Kennungen kommen auf manchen Seiten
      ein Dutzend Mal vor, und ein `is:inline`-Skript in der Komponente wäre
      genauso oft im Dokument gelandet.

      Bewusst eingebettet statt als eigene Datei: so bleibt der Build ohne
      eine einzige JavaScript-Datei und ohne zusätzliche Anfrage.
    */}
    <script is:inline>
      customElements.define(
        'text-scramble',
        class extends HTMLElement {
          connectedCallback() {
            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

            const sicht = this.querySelector('.scramble-sicht');
            if (!sicht) return;

            const ziel = sicht.textContent;
            const takt = Number(this.dataset.tempo) || 32;
            const vorrat = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#%&/=+*';
            // Breite der Zone, in der noch gewuerfelt wird, bevor der echte
            // Buchstabe stehen bleibt.
            const zone = 5;

            const lauf = () => {
              let schritt = 0;
              const takte = ziel.length + zone;

              const uhr = setInterval(() => {
                let aus = '';
                for (let i = 0; i < ziel.length; i++) {
                  const z = ziel[i];
                  // Leerzeichen und Trenner bleiben stehen, sonst verliert
                  // die Zeile ihre Gliederung und wird zu einem Block.
                  if (z === ' ' || z === '·' || z === '—' || z === '&') {
                    aus += z;
                  } else if (i < schritt - zone) {
                    aus += z;
                  } else {
                    aus += vorrat[(Math.random() * vorrat.length) | 0];
                  }
                }
                sicht.textContent = aus;

                if (++schritt > takte) {
                  clearInterval(uhr);
                  sicht.textContent = ziel;
                }
              }, takt);
            };

            // Erst laufen lassen, wenn das Element zu sehen ist. Sonst ist
            // der Effekt bei allem unterhalb des ersten Bildschirms schon
            // vorbei, bevor jemand hinschaut.
            if (!('IntersectionObserver' in window)) return lauf();

            const wache = new IntersectionObserver(
              (eintraege) => {
                for (const e of eintraege) {
                  if (!e.isIntersecting) continue;
                  wache.disconnect();
                  lauf();
                }
              },
              { threshold: 0.6 },
            );
            wache.observe(this);
          }
        },
      );
    </script>
  </body>
</html>
