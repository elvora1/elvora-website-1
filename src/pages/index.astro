---
import Base from '~/layouts/Base.astro';
import Band from '~/components/Band.astro';
import Button from '~/components/Button.astro';
import Portrait from '~/components/Portrait.astro';
import Scramble from '~/components/Scramble.astro';
import Sterne from '~/components/Sterne.astro';
import ReviewBadge from '~/components/ReviewBadge.astro';
import Telefonkarussell from '~/components/Telefonkarussell.astro';
import Kanalkreise from '~/components/Kanalkreise.astro';
import Textrolle from '~/components/Textrolle.astro';
import Vormittag from '~/components/Vormittag.astro';
import { empfangGespraeche } from '~/lib/empfang';
import {
  cta,
  services,
  address,
  owner,
  contactLinks,
  reviews,
} from '~/config/site';

const title = 'Elvora: Mehr Anfragen für Betriebe in Essen';
const description =
  'Website, Google-Sichtbarkeit und automatisierte Abläufe für Betriebe und Selbstständige in Essen und im Ruhrgebiet. Fester Ansprechpartner statt Agentur-Apparat.';

/**
 * Wo Aufträge im Alltag verloren gehen. Konkret, nicht abstrakt.
 *
 * Jede Karte trägt eine eigene Farbe aus der Leistungspalette und ein
 * Zeichen. Vorher waren es drei graue Textspalten, die man überlesen hat.
 */
const verluste = [
  {
    titel: 'Das Telefon klingelt',
    text: 'Sie sind beim Kunden, im Termin, in der Werkstatt. Der Anrufer probiert den nächsten Betrieb. Sie erfahren nie davon.',
    farbe: '#a93d28',
    zeichen: 'M6.5 3h-3v3a10.5 10.5 0 0 0 10.5 10.5h3v-3l-3.5-1.5-2 2A8.5 8.5 0 0 1 7 7l2-2z',
  },
  {
    titel: 'Zwölf Nachrichten am Abend',
    text: 'Dazu vier Rückrufwünsche. Sie arbeiten sie nach Feierabend ab, oder eben nicht.',
    farbe: '#2b2f7a',
    zeichen: 'M3 16l1.2-3A6.5 6.5 0 1 1 6.6 15.4zM7 8h6M7 11h4',
  },
  {
    titel: 'Niemand findet Sie',
    text: 'Gesucht wird bei Google, angerufen wird einer der ersten drei Treffer. Stehen Sie dort nicht, existieren Sie nicht.',
    farbe: '#a63082',
    zeichen: 'M9 4a5 5 0 1 0 0 10 5 5 0 0 0 0-10zM13 13l4 4',
  },
];

/**
 * Was hereinkommt, während der Betrieb arbeitet.
 *
 * Zu jedem Ereignis gehört der Verlauf, der auf dem Telefon dazu abläuft.
 * Blickwinkel ist hier das Telefon des BETRIEBS: der Kunde steht links,
 * die Antwort der Assistenz rechts, weil sie über die eigene Nummer
 * hinausgeht.
 *
 * Die Namen sind Beispiele, keine echten Vorgänge.
 */
const vormittag = [
  {
    kanal: 'WhatsApp',
    farbe: '#a63082',
    zeichen: 'M3 16l1.2-3A6.5 6.5 0 1 1 6.6 15.4zM7 8h6M7 11h4',
    zeit: '08:14',
    text: 'Verstopfter Abfluss, dringend. Termin für 11:30 Uhr vergeben, bevor Sie überhaupt auf dem ersten Dach standen.',
    gespraech: {
      name: 'Frau Kern',
      status: 'zuletzt online 08:16',
      nachrichten: [
        { von: 'kunde' as const, zeit: '08:14', text: 'Guten Morgen, unser Küchenabfluss ist komplett dicht. Kommt heute noch jemand??' },
        { von: 'assistenz' as const, zeit: '08:14', text: 'Guten Morgen, Frau Kern! Heute 11:30 Uhr ist noch frei. Passt das?' },
        { von: 'kunde' as const, zeit: '08:15', text: 'Ja bitte! Wie lange dauert sowas ungefähr?' },
        { von: 'assistenz' as const, zeit: '08:15', text: 'Meist unter einer Stunde. Eingetragen: heute, 11:30 Uhr. Der Kollege hat Ihre Nachricht direkt auf dem Handy.' },
      ],
    },
  },
  {
    kanal: 'Verpasster Anruf',
    farbe: '#a93d28',
    zeichen: 'M6.5 3h-3v3a10.5 10.5 0 0 0 10.5 10.5h3v-3l-3.5-1.5-2 2A8.5 8.5 0 0 1 7 7l2-2z',
    zeit: '09:02',
    text: 'Angerufen, während alle auf der Baustelle waren. Aus dem verpassten Anruf wurde ein Besichtigungstermin für eine Badsanierung.',
    gespraech: {
      name: '0201 ••• ••••',
      status: 'nicht in den Kontakten',
      kuerzel: '?',
      nachrichten: [
        { von: 'assistenz' as const, zeit: '09:02', text: 'Guten Tag, Sie haben uns gerade angerufen. Wir sind vormittags auf der Baustelle. Worum geht es? Ich leite es sofort weiter.' },
        { von: 'kunde' as const, zeit: '09:05', text: 'Guten Tag, wir möchten unser Bad sanieren lassen. Machen Sie sowas?' },
        { von: 'assistenz' as const, zeit: '09:05', text: 'Ja! Am besten schaut sich der Chef das vor Ort an. Wann sind Sie diese Woche zu Hause?' },
        { von: 'kunde' as const, zeit: '09:07', text: 'Donnerstag ab 16 Uhr ginge.' },
        { von: 'assistenz' as const, zeit: '09:07', text: 'Notiert: Donnerstag ab 16 Uhr, Besichtigung Badsanierung. Die Bestätigung mit genauer Uhrzeit kommt heute noch.' },
      ],
    },
  },
  {
    kanal: 'Kontaktformular',
    farbe: '#2b2f7a',
    zeichen: 'M4 4h12a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zM3.5 5.5 10 11l6.5-5.5',
    zeit: '11:37',
    text: 'Anfrage zur Heizungswartung über die Website. Termin steht, Erinnerung kommt automatisch, ohne Ihr Zutun.',
    gespraech: {
      name: 'Familie Weber',
      status: 'zuletzt online 11:40',
      nachrichten: [
        { von: 'kunde' as const, zeit: '11:37', text: 'Guten Tag, ich habe eben das Formular ausgefüllt, wegen der Heizungswartung. Kam das an?' },
        { von: 'assistenz' as const, zeit: '11:37', text: 'Ja, Ihre Anfrage ist da! Für die Wartung wäre nächste Woche Dienstag oder Mittwoch vormittags frei. Was passt besser?' },
        { von: 'kunde' as const, zeit: '11:39', text: 'Mittwoch. Muss ich dafür zu Hause sein?' },
        { von: 'assistenz' as const, zeit: '11:39', text: 'Ja, der Zugang zur Therme reicht. Eingetragen: Mittwoch, 9:00 Uhr. Die Erinnerung kommt am Vortag automatisch.' },
      ],
    },
  },
];

const wege = [
  { label: 'WhatsApp', href: contactLinks.whatsapp, symbol: 'chat' as const, extern: true },
  { label: 'Telefon', href: contactLinks.tel, symbol: 'telefon' as const },
  { label: 'E-Mail', href: contactLinks.mail, symbol: 'brief' as const },
  { label: 'Termin', href: cta.primary.href, symbol: 'kalender' as const },
];
---

<Base title={title} description={description}>
  {/* ===================== Aufschlag =====================
      Zwei Spalten: links die Aussage, rechts die Vorfuehrung.

      Die Bewertungen stehen jetzt DIREKT UNTER DER UEBERSCHRIFT. Vorher
      sassen sie am Fuss der Hero und lagen auf einem Bildschirm mit 900
      Punkten Hoehe genau an der Kante. Ein Beleg, den man erst durch
      Scrollen findet, arbeitet nicht.

      Rechts laeuft der Verlauf, den man auf WhatsApp tatsaechlich bekommt.
      Er beginnt ohne Zutun, weil er beim Laden schon zu sehen ist. Damit
      steht die Vorfuehrung im ersten Blick und nicht erst nach dem halben
      Scrollweg. */}
  <section class="hero">
    <div class="container-content hero-inner">
      <div class="hero-text">
        <p class="hero-kennung kennung">
          <Scramble text={`Digitalagentur aus ${address.city} · Ruhrgebiet`} />
        </p>

        {/* Die Buchstaben klappen einzeln herein. Das ist der bewegte
            Moment im ersten Sichtbereich, und er sitzt auf dem Satz, auf
            den es ankommt, statt auf einer Zierleiste. */}
        <h1
          class="hero-schlag"
          aria-label="Ihr Betrieb wird gefunden, angerufen und beauftragt."
        >
          <Textrolle
            stumm
            teile={[
              { text: 'Ihr Betrieb wird ' },
              { text: 'gefunden', betont: true },
              { text: ', angerufen und beauftragt.' },
            ]}
          />
        </h1>

        <ReviewBadge groesse="gross" class="hero-beleg" />

        <p class="hero-intro">
          Die meisten Betriebe verlieren Aufträge nicht an die Konkurrenz, sondern
          an verpasste Anrufe und eine Website, die niemand findet. Ich bringe
          beides in Ordnung.
        </p>

        <div class="hero-handlung">
          <Button href={cta.primary.href} size="lg" class="max-sm:w-full">
            {cta.primary.label}
          </Button>

          <a
            class="hero-neben"
            href={contactLinks.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            Oder direkt auf WhatsApp schreiben
            <svg
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 10h11M11 6l4 4-4 4" />
            </svg>
          </a>
        </div>

        <p class="hero-notiz">{cta.primary.note}</p>
      </div>

      <div class="hero-geraet">
        {/* Das Karussell nach der Vorlage: drei Telefone, das aktive vorn,
            die anderen seitlich zurueckgedreht, Pfeile schalten durch.
            In jedem laeuft ein anderer Verlauf der Assistenz. */}
        <Telefonkarussell
          kennung="hero-karussell"
          gespraeche={empfangGespraeche}
          bildunterschrift="Schematische Darstellung"
        />

        <p class="hero-geraet-text">
          Auf WhatsApp antwortet zuerst meine KI-Assistenz. Dieselbe, die ich
          für Betriebe einrichte. Sie erleben sie aus der Kundenperspektive,
          statt sie sich vorstellen zu müssen.
        </p>
      </div>
    </div>
  </section>

  {/* ===================== Wo es klemmt ===================== */}
  <Band
    ton="gedaempft"
    kennung="Wo es klemmt"
    heading="Der Auftrag geht an den, der zuerst erreichbar war"
    intro="Nicht an den Besseren. Für einen Betrieb, in dem der Inhaber mitarbeitet, ist das eine unfaire Ausgangslage. Genau die lässt sich abstellen."
  >
    <ul class="verluste">
      {
        verluste.map((v, i) => (
          <li class="verlust einblenden" style={`--verzug:${i};--farbe:${v.farbe}`}>
            <span class="verlust-zeichen" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7"
                stroke-linecap="round" stroke-linejoin="round">
                <path d={v.zeichen} />
              </svg>
            </span>
            <p class="verlust-titel">{v.titel}</p>
            <p class="verlust-text">{v.text}</p>
            <span class="verlust-nummer ziffern" aria-hidden="true">{`0${i + 1}`}</span>
          </li>
        ))
      }
    </ul>
  </Band>

  {/* ===================== Die vier Leistungen ===================== */}
  <Band
    ton="hell"
    kennung="Leistungen"
    heading="Vier Bausteine, einzeln oder zusammen"
    intro="Sie müssen nicht alles auf einmal angehen. Meistens beginnen wir dort, wo gerade am meisten Geld liegen bleibt."
  >
    <ul class="leistungen">
      {
        services.map((service, i) => (
          <li class="leistung" style={`--farbe:${service.color}`}>
            <a class="leistung-link" href={service.href}>
              {/* Die Farbflaeche laeuft beim Vorbeiscrollen von links herein.
                  Sie ist der Grund, warum sich die vier Zeilen ueberhaupt
                  voneinander unterscheiden. */}
              <span class="leistung-flaeche" aria-hidden="true" />

              {/* Die Nummer sitzt in einem Feld in der Farbe der Leistung.
                  Eine kleine graue Ziffer hat vorher nichts gegliedert, ein
                  duenner Balken am Rand kaum mehr. Das Feld ist das Erste,
                  was man beim Scrollen sieht. */}
              <span class="leistung-nummer ziffern" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>

              <span class="leistung-haupt einblenden" style="--verzug:1">
                <span class="leistung-label kennung">{service.label}</span>
                <span class="leistung-nutzen">{service.benefit}</span>
              </span>

              <span class="leistung-teaser einblenden" style="--verzug:2">
                {service.teaser}
              </span>

              <span class="leistung-pfeil" aria-hidden="true">
                <svg
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4 10h11M11 6l4 4-4 4" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Band>

  {/* ===================== Was hereinkommt ===================== */}
  <Band
    ton="hell"
    kennung="Ein Vormittag"
    heading="So sieht ein Vormittag mit Assistenz aus"
    intro="Drei Anfragen, alle beantwortet, keine liegen geblieben. Sie waren in der Zeit bei Ihren Kunden."
  >
    <Vormittag
      ereignisse={vormittag}
      bilanz="3 von 3 beantwortet · 3 Termine im Kalender · 0 verloren"
    />

    {/* Ein Aufruf an der Stelle, an der der Beweis gerade gelaufen ist.
        Vorher standen die Aufrufe nur ganz oben und ganz unten, dazwischen
        lagen 500 Woerter ohne einen einzigen Weg zur Handlung. Wer hier
        ueberzeugt ist, soll nicht erst bis zum Fuss scrollen muessen. */}
    <div class="zwischenruf">
      <p class="zwischenruf-satz">
        So sähe ein Vormittag in Ihrem Betrieb aus. In 15 Minuten schauen wir,
        welcher der drei Wege bei Ihnen gerade am meisten kostet.
      </p>
      <Button href={cta.primary.href} class="max-sm:w-full">
        {cta.primary.label}
      </Button>
    </div>
  </Band>

  {/* ===================== Der Mensch dahinter =====================
      Rundes Portrait mit laufendem Ring, ein Zitat als Kernaussage,
      darunter drei belegbare Fakten. Vorher: ein Textblock und ein
      Rechteckbild, die niemand angeschaut hat. */}
  <Band
    ton="gedaempft"
    textur="punkte"
    kennung="Der Mensch dahinter"
    heading="Erst Baustelle, dann Bildschirm"
  >
    <div class="mensch">
      <div class="mensch-buehne hereinziehen">
        <div class="mensch-ring" aria-hidden="true"></div>
        <Portrait
          rund
          class="mensch-foto"
          alt={`${owner.fullName}, Inhaber von Elvora aus ${address.city}`}
        />
        <p class="mensch-schild">
          <span class="mensch-schild-name">{owner.fullName}</span>
          <span class="mensch-schild-rolle">Inhaber, Elvora</span>
        </p>
      </div>

      <div class="mensch-text">
        <p>
          Gelernt habe ich {owner.trade}, nicht Marketing. Ich stand selbst
          auf der Baustelle, während vorn das Telefon klingelte und der
          Auftrag an den Betrieb ging, der zufällig abheben konnte.
        </p>

        <blockquote class="mensch-zitat">
          Wer das Angebot macht, macht auch die Arbeit{' '}
          <em>und geht ans Telefon.</em>
        </blockquote>

        <p>
          Elvora baut genau dagegen: eine Website, die gefunden wird, und
          eine Assistenz, die rangeht, wenn Sie es nicht können. Sie
          sprechen dabei mit mir, nicht mit einem Ticketsystem.
        </p>

        <ol class="mensch-fakten">
          <li class="einblenden">
            <span class="ziffern" aria-hidden="true">01</span>
            Gelernter {owner.trade}
          </li>
          <li class="einblenden" style="--verzug:1">
            <span class="ziffern" aria-hidden="true">02</span>
            Ein Ansprechpartner, keine Weiterleitung
          </li>
          <li class="einblenden" style="--verzug:2">
            <span class="ziffern" aria-hidden="true">03</span>
            Aus {address.city}, im Einsatz weit darüber hinaus
          </li>
        </ol>

        <a class="mensch-weiter" href="/ueber-mich/">
          Mehr über mich
          <svg
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 10h11M11 6l4 4-4 4" />
          </svg>
        </a>
      </div>
    </div>
  </Band>

  {/* ===================== Bewertungen ===================== */}
  {
    reviews.enabled && reviews.items.length > 0 && (
      <Band
        ton="gedaempft"
        kennung="Bewertungen"
        heading="Was Betriebe hinterher sagen"
      >
        <ul class="stimmen">
          {reviews.items.map((stimme, i) => (
            <li class="stimme einblenden" style={`--verzug:${i}`}>
              <Sterne wert={stimme.rating} groesse={1} />
              <p class="stimme-text">{stimme.text}</p>
              <p class="stimme-quelle">
                <span class="stimme-name">{stimme.author}</span>
                {stimme.business && <span class="stimme-betrieb">{stimme.business}</span>}
              </p>
            </li>
          ))}
        </ul>
      </Band>
    )
  }

  {/* ===================== Abschluss =====================
      Die einzige dunkle Flaeche der Seite. Genau deshalb faellt sie auf. */}
  <Band ton="tief" kennung="Loslegen" heading="Klingt das nach Ihrem Betrieb?">
    <div class="schluss">
      <div class="schluss-text">
        <p>
          In einem kurzen Gespräch schauen wir, wo bei Ihnen gerade Anfragen
          verloren gehen. Ohne Vorbereitung, ohne Verpflichtung. Und wenn ich
          Ihnen nicht helfen kann, sage ich Ihnen das.
        </p>

        <div class="schluss-wege">
          <p class="schluss-wege-titel kennung">Alle Wege zu mir</p>
          <Kanalkreise kanaele={wege} tone="inverse" />
        </div>
      </div>

      <div class="schluss-handlung">
        <Button href={cta.primary.href} size="lg" variant="aufFarbe" class="max-sm:w-full">
          {cta.primary.label}
        </Button>
        {/* Beleg, Dauer und Antwortzeit als EINE Leiste statt vier
            gestapelter Zeilen. An der Stelle der Entscheidung sollen die
            drei Zusagen nebeneinander stehen, nicht untereinander
            tropfen. */}
        <ul class="schluss-beweise">
          <li><ReviewBadge tone="inverse" /></li>
          <li>
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="10" cy="10" r="7" />
              <path d="M10 6v4l2.5 2" />
            </svg>
            Antwort in 24 Stunden
          </li>
          <li>
            <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7"
              stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4.5" width="14" height="12" rx="2" />
              <path d="M3 8.5h14M7 3v3M13 3v3" />
            </svg>
            15 Minuten, unverbindlich
          </li>
        </ul>
      </div>
    </div>
  </Band>
</Base>

<style>
  /* ===================== Aufschlag ===================== */
  .hero {
    background: var(--color-surface);
    /* Die hinteren Telefone des Karussells stehen seitlich ueber. `clip`
       statt `hidden`: hidden macht aus dem Hero einen Scrollbereich. */
    overflow-x: clip;
  }

  .hero-inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 5.5rem);
  }

  /* Zwei Spalten erst, wenn beides nebeneinander wirklich Platz hat. Frueher
     waere das Geraet ein Streifen und die Zeile im Text vier Woerter breit. */
  @media (width >= 64rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      align-items: center;
    }
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.125rem, 2vw, 1.5rem);
  }

  .hero-kennung {
    margin: 0;
    color: var(--color-ink-faint);
  }

  /* Die Groesse traegt hier alles. Instrument Serif hat keinen Fettschnitt,
     die Wirkung kommt aus Mass und Satz.

     Kleiner als in der einspaltigen Fassung: neben dem Geraet steht weniger
     Breite zur Verfuegung, und der Aufruf muss ohne Scrollen zu sehen sein. */
  .hero-schlag {
    margin: 0;
    font-size: clamp(2.375rem, 4.6vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    /* Etwas mehr als vorher: die Buchstaben der Textrolle sind eigene
       Kaestchen, dadurch bauen die Woerter minimal breiter und der Satz
       brach eine Zeile zu frueh um. */
    max-width: 18ch;
  }

  /* Ein einziges Wort kursiv und in der Markenfarbe. Instrument Serif hat
     einen sehr schoenen Kursivschnitt, und ein Akzent wirkt nur, wenn er
     allein steht. Ausgezeichnet wird es in der Textrolle ueber `betont`. */

  .hero-intro {
    margin: 0;
    max-width: 44ch;
    font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .hero-handlung {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem 1.75rem;
    margin-top: clamp(0.25rem, 1vw, 0.5rem);
  }

  /* Der zweite Weg bleibt ein Textlink: flaechig waere er ein zweiter
     Haupt-CTA und wuerde dem ersten die Wirkung nehmen. */
  .hero-neben {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink-muted);
    font-size: 0.9375rem;
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 5px;
    transition: color 0.15s, text-decoration-color 0.15s;
  }

  .hero-neben:hover {
    color: var(--color-ink);
    text-decoration-color: var(--color-ink-faint);
  }

  .hero-neben svg {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  .hero-neben:hover svg {
    transform: translateX(3px);
  }

  .hero-notiz {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-ink-faint);
  }

  /* --- Die Vorfuehrung im ersten Sichtbereich --------------------------- */
  .hero-geraet {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }


  .hero-geraet-text {
    margin: 0;
