---
import Base from '~/layouts/Base.astro';
import PanelHero from '~/components/PanelHero.astro';
import Band from '~/components/Band.astro';
import CtaBand from '~/components/CtaBand.astro';
import { services, automationModules, serviceArea } from '~/config/site';
---

<Base
  kopfFarbe="#2b2f7a"
  title="Leistungen für Betriebe in Essen"
  description="Webdesign, lokale Suchmaschinenoptimierung, Branding und KI-Automatisierung für Betriebe und Selbstständige in Essen und im Ruhrgebiet."
  breadcrumbs={[{ label: 'Leistungen' }]}
>
  <PanelHero
    eyebrow="Leistungen"
    heading="Vier Bausteine gegen die vier häufigsten Engpässe"
    intro="Sie müssen nicht alles auf einmal angehen. Meistens beginnen wir dort, wo gerade am meisten Geld liegen bleibt, und bauen von da aus weiter."
    color="#2b2f7a"
    breadcrumbs={[{ label: 'Leistungen' }]}
  />

  {/* Jede Leistung ein eigener Streifen in ihrer Farbe: dieselbe Farbe wie
      ihre Flaeche auf der Startseite und ihre Detailseite. Dadurch gehoeren
      die drei Orte sichtbar zusammen, ohne dass es jemand erklaeren muss. */}
  {
    services.map((service, i) => (
      <Band
        ton="farbe"
        farbe={service.color}
        kennung={`0${i + 1} — ${service.label}`}
        breite="inhalt"
      >
        <a class="streifen" href={service.href}>
          <div class="streifen-text">
            <h2 class="streifen-schlag">{service.benefit}</h2>
            <p class="streifen-teaser">{service.teaser}</p>

            {service.slug === 'automatisierung' && (
              <p class="streifen-zusatz kennung">
                {automationModules.length} einsatzbereite Module
              </p>
            )}
          </div>

          <span class="streifen-weiter">
            <span class="streifen-weiter-text">
              {service.slug === 'automatisierung'
                ? 'Alle Module ansehen'
                : `${service.label} im Detail`}
            </span>
            <svg
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 10h11M11 6l4 4-4 4" />
            </svg>
          </span>
        </a>
      </Band>
    ))
  }

  <Band ton="gedaempft" raum="md">
    <p class="gebiet">Betreut werden Betriebe in {serviceArea.display}.</p>
  </Band>

  <CtaBand />
</Base>

<style>
  /* Der ganze Streifen ist der Link. Kein Kasten, keine Rundung: die
     Farbflaeche selbst ist die Schaltflaeche. */
  .streifen {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: end;
    color: inherit;
    text-decoration: none;
  }

  @media (width >= 64rem) {
    .streifen {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  .streifen-text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .streifen-schlag {
    margin: 0;
    color: #fff;
    font-size: clamp(1.875rem, 4.5vw, 3.25rem);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.015em;
    max-width: 18ch;
  }

  .streifen-teaser {
    margin: 0;
    max-width: 52ch;
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
    line-height: 1.6;
    opacity: 0.92;
  }

  .streifen-zusatz {
    margin: 0;
    opacity: 0.8;
  }

  .streifen-weiter {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding-bottom: 0.375rem;
    border-bottom: 1px solid currentColor;
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .streifen-weiter svg {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  .streifen:hover .streifen-weiter svg,
  .streifen:focus-visible .streifen-weiter svg {
    transform: translateX(5px);
  }

  .streifen:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 1rem;
    border-radius: 0.25rem;
  }

  .gebiet {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
  }
</style>
