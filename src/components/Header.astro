---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { nav, cta } from '~/config/site';

/**
 * Kopfbereich.
 *
 * Klebt oben -- damit bleibt der Haupt-CTA auf dem Handy beim Scrollen
 * jederzeit erreichbar. Das mobile Menue laeuft ueber <details>, also ganz
 * ohne JavaScript.
 */
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-border bg-surface/90 backdrop-blur-sm">
  <div class="container-content">
    <div class="flex h-16 items-center justify-between gap-4 md:h-18">
      <a href="/" class="shrink-0" aria-label="Elvora, zur Startseite">
        <Logo />
      </a>

      <nav aria-label="Hauptnavigation" class="hidden md:block">
        <ul class="flex items-center gap-8">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'text-[0.9375rem] transition-colors hover:text-ink',
                    isActive(item.href) ? 'text-ink font-medium' : 'text-ink-muted',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <!-- Der eine Haupt-CTA. Auf Mobil verkuerzt, aber immer sichtbar. -->
        <Button href={cta.primary.href} class="max-md:h-10 max-md:px-4 max-md:text-sm">
          <span class="md:hidden">{cta.primary.labelShort}</span>
          <span class="max-md:hidden">{cta.primary.label}</span>
        </Button>

        <!-- Mobiles Menue ohne JavaScript -->
        <details class="group relative md:hidden">
          <summary
            class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-button border border-border text-ink-muted transition-colors hover:text-ink [&::-webkit-details-marker]:hidden"
            aria-label="Menü öffnen"
          >
            <svg
              viewBox="0 0 20 20"
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M3 6h14M3 10h14M3 14h14" class="group-open:hidden" />
              <path d="M5 5l10 10M15 5L5 15" class="hidden group-open:block" />
            </svg>
          </summary>

          <div
            class="absolute right-0 top-[calc(100%+0.5rem)] w-56 rounded-card border border-border bg-surface p-2 shadow-raised"
          >
            <ul class="flex flex-col">
              {
                nav.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive(item.href) ? 'page' : undefined}
                      class:list={[
                        'block rounded-lg px-3 py-2.5 text-[0.9375rem] transition-colors hover:bg-surface-subtle',
                        isActive(item.href) ? 'text-ink font-medium' : 'text-ink-muted',
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>
