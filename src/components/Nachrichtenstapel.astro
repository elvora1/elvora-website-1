---
/**
 * Gestaffelte Nachrichtenkarten.
 *
 * Übernimmt eine React-Vorlage, in der allerdings kein React-Verhalten
 * steckt: die ganze Wirkung sind Transformationen und Übergänge. Übrig
 * bleibt also CSS. Das Symbol kam dort aus einer Icon-Bibliothek, hier
 * steht es als Pfad direkt in der Datei.
 *
 * ZWECK: zeigt, was die WhatsApp-Assistenz tatsächlich tut, statt es zu
 * behaupten. Drei Anfragen, die parallel hereinkommen, während der Betrieb
 * auf der Baustelle, in der Praxis oder beim Kunden ist.
 *
 * DER FÄCHER LÄUFT ÜBER DIE SCROLLPOSITION, NICHT ÜBER DIE MAUS.
 *
 * In der Vorlage liegen die Karten übereinander und fächern erst beim Zeigen
 * mit der Maus auf. Auf dem Handy gibt es kein Hover: dort bliebe der Stapel
 * dauerhaft zusammengeschoben und der Text unlesbar. Und wer nicht darauf
 * zeigt, sieht nie, was dort steht.
 *
 * Hier bindet `animation-timeline: view()` das Auffächern an die
 * Scrollposition. Die Karten liegen erst gestapelt und schräg übereinander
 * und rücken beim Vorbeiscrollen auseinander. Damit sieht jeder den Effekt,
 * auf jedem Gerät, ohne etwas tun zu müssen.
 *
 * Ohne Unterstützung dafür stehen die Karten von vornherein aufgefächert.
 * Der Effekt ist eine Zugabe, nie die Voraussetzung dafür, den Inhalt zu
 * lesen.
 */
interface Props {
  nachrichten: Array<{ zeit: string; text: string; kanal: string }>;
  class?: string;
}

const { nachrichten, class: className = '' }: Props = Astro.props;
---

<ul class={`stapel ${className}`}>
  {
    nachrichten.map((n, i) => (
      <li class="stapel-karte" style={`--rang:${i}`}>
        <p class="stapel-kopf">
          <span class="stapel-symbol" aria-hidden="true">
            <svg viewBox="0 0 20 20" fill="currentColor">
              <path d="M10 2a8 8 0 0 0-6.9 12.03L2 18l4.07-1.06A8 8 0 1 0 10 2zm0 1.6a6.4 6.4 0 1 1-3.3 11.88l-.28-.17-2.1.55.56-2.04-.18-.29A6.4 6.4 0 0 1 10 3.6z" />
            </svg>
          </span>
          <span class="stapel-kanal kennung">{n.kanal}</span>
          <span class="stapel-zeit kennung">{n.zeit}</span>
        </p>
        <p class="stapel-text">{n.text}</p>
      </li>
    ))
  }
</ul>

<style>
  .stapel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stapel-karte {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.26);
    border-radius: 0.875rem;
    /* Dunkler statt heller: auf den kraeftigen Tafelfarben hebt sich eine
       abgedunkelte Karte besser ab als eine aufgehellte, und der weisse
       Text darauf bleibt kontrastreich. */
    background: rgb(0 0 0 / 0.16);
    padding: 0.875rem 1rem;
  }

  .stapel-kopf {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
  }

  .stapel-symbol {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.16);
  }

  .stapel-symbol svg {
    width: 0.875rem;
    height: 0.875rem;
  }

  .stapel-kanal {
    opacity: 0.85;
  }

  .stapel-zeit {
    margin-inline-start: auto;
    opacity: 0.78;
  }

  .stapel-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.45;
    opacity: 1;
  }

  /* Ruhestellung: aufgefaechert. Wer keine scrollgebundenen Animationen
     unterstuetzt, sieht genau das, und der Text ist lesbar. */
  .stapel-karte {
    transform-origin: left center;
    transform: rotate(calc((var(--rang) - 1) * 1.2deg))
      translateX(calc(var(--rang) * 0.5rem));
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.25s,
      border-color 0.25s;
  }

  @media (hover: hover) {
    .stapel-karte:hover {
      transform: rotate(0deg) translateX(0) translateY(-2px);
      background: rgb(0 0 0 / 0.26);
      border-color: rgb(255 255 255 / 0.45);
    }
  }

  /* --- Das Auffaechern -------------------------------------------------
     Ausgangsstellung: die Karten liegen uebereinander, gestapelt und
     schraeg. Endstellung: aufgefaechert und lesbar. Dazwischen entscheidet
     die Scrollposition, nicht der Mauszeiger.

     `--hoehe` ist die Ueberlappung im gestapelten Zustand. Negativ, damit
     die Karten aufeinander rutschen.

     Bewusst NICHT ueber die Utility `einblenden`: die endet auf
     `transform: none` und wuerde die Faecherstellung plattmachen. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .stapel-karte {
        animation: auffaechern linear both;
        animation-timeline: view();
        /* Alle Karten teilen sich denselben Bereich: der Stapel oeffnet
           sich als Ganzes, statt Karte fuer Karte nachzuklappern. */
        animation-range: entry 12% entry 70%;
      }
    }
  }

  @keyframes auffaechern {
    from {
      opacity: 0.35;
      transform: translateY(calc(var(--rang) * -3.6rem))
        translateX(calc(var(--rang) * 1.25rem)) rotate(-5deg) scale(0.96);
    }
    to {
      opacity: 1;
      transform: rotate(calc((var(--rang) - 1) * 1.2deg))
        translateX(calc(var(--rang) * 0.5rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stapel-karte {
      transform: none;
      transition: none;
    }
  }
</style>
