---
import Button from './Button.astro';
import Geraet from './Geraet.astro';
import Tippend from './Tippend.astro';
import { contactLinks } from '~/config/site';

/**
 * Der Empfang, den man dort tatsächlich bekommt. Die letzte Zeile schreibt
 * sich selbst, damit der Block die Assistenz zeigt statt sie zu behaupten.
 */
const empfang = [
  { von: 'sie' as const, text: 'Hallo, ich hätte Interesse an einer Website.' },
  {
    von: 'wir' as const,
    text: 'Hallo! Ich bin die digitale Assistenz von Elvora. Worum geht es genau?',
  },
  { von: 'sie' as const, text: 'Wir sind ein Betrieb mit acht Leuten.' },
  {
    von: 'wir' as const,
    text: 'Danke, ich gebe das an Luan weiter. Er meldet sich heute noch bei Ihnen.',
  },
];

/**
 * WhatsApp als bevorzugter Kontaktweg.
 *
 * Der eigentliche Kniff: Wer hier schreibt, wird von der KI-Assistenz
 * empfangen, also genau von dem Produkt, das verkauft werden soll.
 * Der Kontaktweg ist damit zugleich die Vorführung.
 */
interface Props {
  /** `panel` für den hervorgehobenen Block, `inline` für den knappen Hinweis. */
  variant?: 'panel' | 'inline';
  class?: string;
}

const { variant = 'panel', class: className = '' }: Props = Astro.props;
---

{
  variant === 'panel' ? (
    <div
      class={`rounded-card border border-accent/20 bg-accent-soft p-7 md:p-9 ${className}`}
    >
      <span class="inline-flex items-center gap-2 text-sm font-medium text-accent">
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.48 1.34 5L2 22l5.16-1.35a9.93 9.93 0 004.88 1.27h.01c5.5 0 9.96-4.46 9.96-9.96 0-2.66-1.04-5.16-2.92-7.04A9.88 9.88 0 0012.04 2zm0 18.24h-.01a8.26 8.26 0 01-4.21-1.15l-.3-.18-3.13.82.83-3.05-.2-.31a8.24 8.24 0 01-1.26-4.41c0-4.57 3.72-8.28 8.29-8.28 2.21 0 4.29.86 5.86 2.43a8.23 8.23 0 012.42 5.86c0 4.57-3.72 8.27-8.29 8.27zm4.545-6.2c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.79.97-.14.16-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.38-1.72-.15-.25-.02-.38.11-.5.11-.12.25-.29.37-.44.13-.15.17-.25.25-.42.09-.16.04-.31-.02-.44-.06-.12-.56-1.35-.77-1.84-.2-.49-.4-.42-.55-.43h-.47c-.16 0-.42.06-.64.31-.22.25-.84.82-.84 2s.86 2.32.98 2.48c.12.17 1.7 2.59 4.11 3.63.58.25 1.02.4 1.37.51.58.18 1.1.16 1.51.1.46-.07 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.11-.22-.17-.47-.29z" />
        </svg>
        WhatsApp
      </span>

      <h2 class="mt-3 text-2xl">Schreiben Sie mir und sehen Sie die Assistenz gleich in Aktion</h2>

      <p class="mt-4 text-ink-muted">
        Auf WhatsApp empfängt Sie zuerst meine KI-Assistenz. Es ist dieselbe, die
        ich für Betriebe einrichte. Sie erleben also aus der Kundenperspektive,
        was Ihre eigene Kundschaft erleben würde, statt es sich aus einer
        Beschreibung vorstellen zu müssen.
      </p>

      <p class="mt-3 text-ink-muted">
        Sobald es persönlich wird, übernehme ich. Genau so würde es bei Ihnen
        auch laufen.
      </p>

      {/* Die Vorfuehrung selbst. Der Rahmen sagt: das laeuft auf dem
          Telefon. Die Beschriftung sagt, dass es nachgebaut ist. */}
      <div class="wa-vorfuehrung">
        <Geraet art="handy" bildunterschrift="Schematische Darstellung">
          <ul class="wa-chat">
            {empfang.map((n, i) => (
              <li class:list={['wa-blase', n.von === 'wir' && 'wa-blase-wir']}>
                {i === empfang.length - 1 ? <Tippend text={n.text} dauer={2.4} /> : n.text}
              </li>
            ))}
          </ul>
        </Geraet>
      </div>

      <div class="mt-7 flex flex-col items-start gap-2">
        <Button
          href={contactLinks.whatsapp}
          size="lg"
          class="max-sm:w-full"
          target="_blank"
          rel="noopener noreferrer"
        >
          Auf WhatsApp schreiben
        </Button>
        <p class="text-sm text-accent/70">Antwort in der Regel sofort</p>
      </div>
    </div>
  ) : (
    <p class={`text-sm ${className}`}>
      <a
        href={contactLinks.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 underline underline-offset-4 transition-opacity hover:opacity-80"
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
          <path d="M12.04 2c-5.5 0-9.96 4.46-9.96 9.96 0 1.76.46 3.48 1.34 5L2 22l5.16-1.35a9.93 9.93 0 004.88 1.27h.01c5.5 0 9.96-4.46 9.96-9.96 0-2.66-1.04-5.16-2.92-7.04A9.88 9.88 0 0012.04 2zm0 18.24h-.01a8.26 8.26 0 01-4.21-1.15l-.3-.18-3.13.82.83-3.05-.2-.31a8.24 8.24 0 01-1.26-4.41c0-4.57 3.72-8.28 8.29-8.28 2.21 0 4.29.86 5.86 2.43a8.23 8.23 0 012.42 5.86c0 4.57-3.72 8.27-8.29 8.27z" />
        </svg>
        Auf WhatsApp schreiben
      </a>
      <span class="opacity-70">. Dort antwortet direkt meine KI-Assistenz.</span>
    </p>
  )
}

<style>
  .wa-vorfuehrung {
    margin-top: 1.75rem;
    max-width: 17rem;
  }

  .wa-chat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 3.25rem 0.75rem 1rem;
    list-style: none;
  }

  .wa-blase {
    max-width: 88%;
    align-self: flex-start;
    border-radius: 0.875rem 0.875rem 0.875rem 0.25rem;
    background: var(--color-surface-subtle);
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--color-ink);
  }

  .wa-blase-wir {
    align-self: flex-end;
    border-radius: 0.875rem 0.875rem 0.25rem;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }
</style>
