---
import Logo from './Logo.astro';
import Button from './Button.astro';
import { nav, cta } from '~/config/site';

/**
 * Kopfbereich.
 *
 * Klebt oben -- damit bleibt der Haupt-CTA auf dem Handy beim Scrollen
 * jederzeit erreichbar. Das mobile Menue laeuft ueber <details>, also ganz
 * ohne JavaScript.
 *
 * FARBE: Jede Seite beginnt mit einer farbigen Tafel. Stand die Leiste in
 * Weiss darueber, fing die Seite mit einem Streifen an statt mit einem
 * Eindruck. Sie uebernimmt deshalb die Farbe der jeweiligen Tafel und laeuft
 * nahtlos in sie hinein.
 *
 * Bewusst ohne Umschlagen auf Weiss beim Weiterscrollen: das ginge nur mit
 * einem Scroll-Beobachter, und dafuer lohnt kein Skript.
 */
interface Props {
  /** Farbe der Kopftafel dieser Seite. Ohne Angabe bleibt die Leiste weiss. */
  kopfFarbe?: string;
}

const { kopfFarbe }: Props = Astro.props;
const dunkel = Boolean(kopfFarbe);

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header
  class="kopf sticky top-0 z-50 border-b"
  data-ton={dunkel ? 'dunkel' : 'hell'}
  style={kopfFarbe ? `--kopf-grund:${kopfFarbe}` : undefined}
>
  <div class="container-content">
    <div class="flex h-16 items-center justify-between gap-4 md:h-18">
      <a href="/" class="flex shrink-0 items-center min-h-11" aria-label="Elvora, zur Startseite">
        <Logo ton={dunkel ? 'hell' : 'dunkel'} />
      </a>

      <nav aria-label="Hauptnavigation" class="hidden md:block">
        <ul class="flex items-center gap-8">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                  class:list={[
                    'kopf-link text-[0.9375rem] transition-colors',
                    isActive(item.href) && 'ist-hier font-medium',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-2">
        <!-- Der eine Haupt-CTA. Auf Mobil verkuerzt, aber immer sichtbar.
             Auf farbiger Leiste weiss: die Akzentfarbe geht auf der
             Magenta-Tafel sonst unter. -->
        <Button
          href={cta.primary.href}
          variant={dunkel ? 'aufFarbe' : 'primary'}
          class="max-md:h-10 max-md:px-4 max-md:text-sm"
        >
          <span class="md:hidden">{cta.primary.labelShort}</span>
          <span class="max-md:hidden">{cta.primary.label}</span>
        </Button>

        <!-- Mobiles Menue ohne JavaScript -->
        <details class="group relative md:hidden">
          <summary
            class="kopf-knopf flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-button border transition-colors [&::-webkit-details-marker]:hidden"
            aria-label="Menü öffnen"
          >
            <svg
              viewBox="0 0 20 20"
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M3 6h14M3 10h14M3 14h14" class="group-open:hidden" />
              <path d="M5 5l10 10M15 5L5 15" class="hidden group-open:block" />
            </svg>
          </summary>

          <div
            class="absolute right-0 top-[calc(100%+0.5rem)] w-56 rounded-card border border-border bg-surface p-2 shadow-raised"
          >
            <ul class="flex flex-col">
              {
                nav.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive(item.href) ? 'page' : undefined}
                      class:list={[
                        'block rounded-lg px-3 py-2.5 text-[0.9375rem] transition-colors hover:bg-surface-subtle',
                        isActive(item.href) ? 'text-ink font-medium' : 'text-ink-muted',
                      ]}
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </details>
      </div>
    </div>
  </div>
</header>

<style>
  .kopf {
    background: var(--kopf-grund, var(--color-surface));
    border-bottom-color: var(--color-border);
  }

  .kopf-link {
    color: var(--color-ink-muted);
  }

  .kopf-link:hover,
  .kopf-link.ist-hier {
    color: var(--color-ink);
  }

  .kopf-knopf {
    border-color: var(--color-border);
    color: var(--color-ink-muted);
  }

  .kopf-knopf:hover {
    color: var(--color-ink);
  }

  /* --- Auf farbiger Tafel ---------------------------------------------
     Kein Weichzeichner im Hintergrund: die Leiste steht auf einer
     deckenden Flaeche derselben Farbe, da gaebe es nichts zu zeichnen,
     und `backdrop-filter` kostet auf schwachen Geraeten spuerbar Leistung. */
  .kopf[data-ton='dunkel'] {
    border-bottom-color: rgb(255 255 255 / 0.14);
  }

  .kopf[data-ton='dunkel'] .kopf-link {
    color: rgb(255 255 255 / 0.72);
  }

  .kopf[data-ton='dunkel'] .kopf-link:hover,
  .kopf[data-ton='dunkel'] .kopf-link.ist-hier {
    color: #fff;
  }

  .kopf[data-ton='dunkel'] .kopf-knopf {
    border-color: rgb(255 255 255 / 0.28);
    color: rgb(255 255 255 / 0.8);
  }

  .kopf[data-ton='dunkel'] .kopf-knopf:hover {
    color: #fff;
  }

  /* Die aufgeklappte Liste bleibt hell: dort steht Text auf Weiss, und ein
     zweites Farbschema fuer ein Menue mit drei Eintraegen waere Aufwand
     ohne Gewinn. */
  .kopf[data-ton='hell'] {
    background: color-mix(in srgb, var(--color-surface) 90%, transparent);
    backdrop-filter: blur(4px);
  }
</style>
