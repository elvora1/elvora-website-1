---
import mark from '~/assets/mark.svg';
import { planen, WECHSEL } from '~/lib/chat';
import type { Blickwinkel, Gespraech, Nachricht } from '~/lib/chat';

/**
 * Ein Nachrichtenverlauf, wie er auf dem Telefon aussieht.
 *
 * BLICKWINKEL: Wessen Telefon zu sehen ist, entscheidet `blickwinkel`.
 * Beim Kunden stehen seine Nachrichten rechts und die der Assistenz links.
 * Beim Betrieb ist es umgekehrt, denn dort geht die Antwort über die
 * eigene Nummer hinaus.
 *
 * MEHRERE VERLÄUFE: Über `gespraeche` laufen mehrere Verläufe nacheinander
 * auf demselben Schirm, so wie man auf einem echten Gerät von einem Chat in
 * den nächsten wechselt. Jeder Verlauf ist ein vollständiger Schirm mit
 * eigener Statusleiste, eigenem Kopf und eigenem Namen. Sie liegen
 * übereinander und werden nacheinander eingeblendet.
 *
 * ABLAUF: Es spielt sich einmal ab, sobald es zu sehen ist. Vor jeder
 * Nachricht des Gegenübers erscheint erst die Tippanzeige, dann die
 * Nachricht. Die eigenen Antworten stehen sofort da.
 *
 * Der Ablauf läuft über CSS-Verzögerungen, ausgelöst von einem Attribut.
 * Kein Zustand, keine Schleife, kein Nachrechnen zur Laufzeit.
 *
 * OHNE JAVASCRIPT steht der vollständige Verlauf da. Das Verstecken vor
 * dem Start hängt an `html[data-js]`, und das setzt nur ein Skript.
 *
 * Bei `prefers-reduced-motion` steht der erste Verlauf sofort vollständig da.
 */
interface Props {
  /** Einzelner Verlauf: Name im Kopf. */
  name?: string;
  /** Einzelner Verlauf: Zeile unter dem Namen. */
  status?: string;
  /** Einzelner Verlauf: die Nachrichten. */
  nachrichten?: Nachricht[];
  /** Einzelner Verlauf: Uhrzeit in der Statusleiste. */
  uhrzeit?: string;
  /** Mehrere Verläufe nacheinander. Ersetzt die vier Angaben darüber. */
  gespraeche?: Gespraech[];
  blickwinkel?: Blickwinkel;
  /** Streckt oder staucht den Ablauf. Kleiner ist schneller. */
  tempo?: number;
  /**
   * Worin der Verlauf steht. Auf dem Telefon gehört die Statusleiste dazu,
   * im Fenster auf dem Rechner nicht: dort sitzt sie am Bildschirmrand und
   * nicht über dem Gespräch.
   */
  geraet?: 'telefon' | 'fenster';
  class?: string;
}

const {
  name = 'Elvora',
  status = 'online',
  nachrichten,
  uhrzeit = '9:41',
  gespraeche,
  blickwinkel = 'kunde',
  tempo = 1,
  geraet = 'telefon',
  class: className = '',
}: Props = Astro.props;

/* Der einzelne Verlauf ist nur der Sonderfall mit genau einem Eintrag.
   Damit gibt es im Markup und im CSS nur einen Weg. */
const eingaben: Gespraech[] = gespraeche ?? [
  { name, status, uhrzeit, bild: mark.src, nachrichten: nachrichten ?? [] },
];

const { folge } = planen(eingaben, blickwinkel, tempo);
const mehrere = folge.length > 1;
---

<div class={`chat chat-in-${geraet} ${className}`} data-chat style={`--wechsel:${WECHSEL}s`}>
  {
    folge.map((gespraech, stelle) => (
      <div
        class:list={[
          'chat-schirm',
          mehrere && 'chat-teil',
          stelle === folge.length - 1 && 'chat-letzte',
        ]}
        style={`--von:${gespraech.von.toFixed(2)}s;--bis:${gespraech.bis.toFixed(2)}s`}
      >
        {/* --- Statusleiste -----------------------------------------------
             Gehoert zum Telefon, nicht zum Gespraech. Im Fenster auf dem
             Rechner sitzt sie am Bildschirmrand und faellt hier weg.
             Alles andere ist auf jedem Geraet Zeichen fuer Zeichen gleich. */}
        {geraet === 'telefon' && (
        <div class="chat-status" aria-hidden="true">
          <span class="chat-uhr">{gespraech.uhrzeit}</span>
          <span class="chat-anzeigen">
            <svg viewBox="0 0 18 12" class="chat-signal" fill="currentColor">
              <rect x="0" y="8" width="3" height="4" rx="1" />
              <rect x="5" y="5.5" width="3" height="6.5" rx="1" />
              <rect x="10" y="3" width="3" height="9" rx="1" />
              <rect x="15" y="0.5" width="3" height="11.5" rx="1" opacity="0.35" />
            </svg>
            <svg viewBox="0 0 16 12" class="chat-wlan" fill="currentColor">
              <path d="M8 11.2 5.6 8.6a3.4 3.4 0 0 1 4.8 0zM8 6.1c-1.5 0-2.9.6-3.9 1.6L2.8 6.3A7.4 7.4 0 0 1 8 4.2c2 0 3.9.8 5.2 2.1l-1.3 1.4A5.4 5.4 0 0 0 8 6.1zM8 2.2c-2.5 0-4.9 1-6.6 2.7L0 3.5A11.3 11.3 0 0 1 8 .3c3.1 0 6 1.2 8 3.2l-1.4 1.4A9.3 9.3 0 0 0 8 2.2z" />
            </svg>
            <svg viewBox="0 0 26 12" class="chat-akku" fill="none">
              <rect x="0.5" y="0.5" width="21" height="11" rx="3" stroke="currentColor" opacity="0.45" />
              <rect x="2" y="2" width="16" height="8" rx="1.6" fill="currentColor" />
              <path d="M23.5 4.2v3.6a2 2 0 0 0 0-3.6z" fill="currentColor" opacity="0.45" />
            </svg>
          </span>
        </div>
        )}

        {/* --- Kopf des Verlaufs ---------------------------------------- */}
        <div class="chat-kopf">
          <svg viewBox="0 0 20 20" class="chat-zurueck" fill="none" stroke="currentColor"
            stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4 6 10l6 6" />
          </svg>

          {gespraech.bild ? (
            <img class="chat-bild" src={gespraech.bild} alt="" aria-hidden="true" width="34" height="34" />
          ) : (
            <span class="chat-bild chat-kuerzel" aria-hidden="true">{gespraech.kuerzel}</span>
          )}

          <span class="chat-wer">
            <span class="chat-name">{gespraech.name}</span>
            <span class="chat-status-text">{gespraech.status}</span>
          </span>

          <svg viewBox="0 0 20 20" class="chat-kamera" fill="currentColor" aria-hidden="true">
            <path d="M2.5 5.5h9a1.5 1.5 0 0 1 1.5 1.5v6a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 1 13V7a1.5 1.5 0 0 1 1.5-1.5zM14.5 8.6l3.3-2.1a.6.6 0 0 1 .9.5v6a.6.6 0 0 1-.9.5l-3.3-2.1z" />
          </svg>
        </div>

        {/* --- Der Verlauf ----------------------------------------------- */}
        <ol class="chat-verlauf">
          <li class="chat-tag" aria-hidden="true"><span>{gespraech.stempel}</span></li>

          {gespraech.nachrichten.map((n) => (
            <>
              {n.links && (
                <li
                  class="chat-zeile chat-links chat-tippzeile"
                  style={`--ab:${n.tippenAb.toFixed(2)}s;--dauer:${n.tippenDauer.toFixed(2)}s`}
                  aria-hidden="true"
                >
                  <span class="chat-halter">
                    <span class="chat-blase chat-blase-links chat-tippen">
                      <span class="chat-punkt" />
                      <span class="chat-punkt" />
                      <span class="chat-punkt" />
                    </span>
                  </span>
                </li>
              )}

              <li
                class:list={['chat-zeile', n.links ? 'chat-links' : 'chat-rechts']}
                style={`--ab:${n.ab.toFixed(2)}s`}
              >
                <span class="chat-halter">
                  <span
                    class:list={[
                      'chat-blase',
                      n.links ? 'chat-blase-links' : 'chat-blase-rechts',
                    ]}
                  >
                    {n.text}
                    <span class="chat-meta">
                      <span class="chat-zeit">{n.zeit}</span>
                      {!n.links && (
                        <svg viewBox="0 0 16 11" class="chat-haken" fill="none" stroke="currentColor"
                          stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M1 6l3 3 5.5-6.5M7 9l5.5-6.5" />
                        </svg>
                      )}
                    </span>
                  </span>
                </span>
              </li>
            </>
          ))}
        </ol>

        {/* --- Eingabezeile ---------------------------------------------- */}
        <div class="chat-eingabe" aria-hidden="true">
          <span class="chat-feld">Nachricht</span>
          <span class="chat-senden">
            <svg viewBox="0 0 20 20" fill="currentColor">
              <path d="M2.2 17.5 18.5 10 2.2 2.5 2.2 8.3l11 1.7-11 1.7z" />
            </svg>
          </span>
        </div>
      </div>
    ))
  }
</div>

<style>
  /* Alle Schirme liegen in derselben Rasterzelle uebereinander. Damit
     bestimmt der hoechste die Hoehe nicht: das Raster hat genau eine Reihe
     und die fuellt den Telefonbildschirm. */
  .chat {
    display: grid;
    grid-template-rows: 1fr;
    height: 100%;
    overflow: hidden;
    /* Hintergrund wie im Messenger: warmes Papier statt Weiss. */
    background: #efe7de;
    font-family: var(--font-sans);
  }

  .chat-schirm {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
    background: #efe7de;
  }

  /* Ruhezustand bei mehreren Verlaeufen: nur der LETZTE steht da, also das
     Ergebnis. Ohne diese Regel laegen ohne JavaScript und ohne Bewegung
     alle drei uebereinander und ergaeben Buchstabensalat. */
  .chat-teil {
    opacity: 0;
    visibility: hidden;
  }

  .chat-teil.chat-letzte {
    opacity: 1;
    visibility: visible;
  }

  /* --- Statusleiste ---------------------------------------------------- */
  .chat-status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 1.15rem 0.3rem;
    background: #f6f2ee;
    color: #16181d;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .chat-anzeigen {
    display: flex;
    align-items: center;
    gap: 0.28rem;
  }

  .chat-signal { width: 1rem; }
  .chat-wlan { width: 0.9rem; }
  .chat-akku { width: 1.45rem; }

  /* --- Kopf ------------------------------------------------------------- */
  .chat-kopf {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.7rem 0.6rem;
    background: #f6f2ee;
    border-bottom: 1px solid rgb(0 0 0 / 0.08);
  }

  .chat-zurueck {
    width: 0.9rem;
    flex-shrink: 0;
    color: #2f6df6;
  }

  .chat-bild {
    width: 2.05rem;
    height: 2.05rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: #fff;
    padding: 0.28rem;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.07);
  }

  /* Ohne Bild stehen die Anfangsbuchstaben im Kreis, wie im Messenger bei
     einem Kontakt ohne Profilbild. Kein erfundenes Gesicht. */
  .chat-kuerzel {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: #cfd4da;
    color: #4a5058;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .chat-wer {
    display: flex;
    flex-direction: column;
    min-width: 0;
    line-height: 1.2;
  }

  .chat-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #16181d;
  }

  .chat-status-text {
    font-size: 0.625rem;
    color: #6b7079;
  }

  .chat-kamera {
    width: 1.05rem;
    margin-inline-start: auto;
    flex-shrink: 0;
    color: #2f6df6;
  }

  /* --- Verlauf ---------------------------------------------------------- */
  /* Nachrichten sammeln sich UNTEN und wachsen nach oben, wie in jedem
     Messenger. Oben verankert klaffte waehrend des Ablaufs eine grosse
     leere Flaeche unter den ersten Nachrichten. */
  .chat-verlauf {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0;
    margin: 0;
    padding: 0.7rem 0.6rem 0.5rem;
    list-style: none;
    overflow: hidden;
  }

  .chat-tag {
    align-self: center;
    margin-bottom: 0.35rem;
  }

  .chat-tag span {
    display: inline-block;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.75);
    font-size: 0.5625rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #6b7079;
  }

  /* Jede Zeile ist ein Raster mit genau einer Reihe. Deren Hoehe laesst
     sich von 0fr auf 1fr animieren, anders als `height: auto`, das sich
     nicht animieren laesst. Der Halter darin wird beschnitten.

     Das ist der Grund, warum der Verlauf von unten waechst: eine noch
     nicht erschienene Nachricht belegt keinen Platz. Vorher standen alle
     Zeilen von Anfang an da, nur unsichtbar, und der Verlauf klebte
     dadurch oben. */
  .chat-zeile {
    display: grid;
    grid-template-rows: 1fr;
  }

  .chat-halter {
    display: flex;
    min-height: 0;
    overflow: hidden;
  }

  .chat-links .chat-halter { justify-content: flex-start; }
  .chat-rechts .chat-halter { justify-content: flex-end; }

  .chat-blase {
    position: relative;
    max-width: 82%;
    padding: 0.34rem 0.5rem 0.28rem;
    border-radius: 0.5rem;
    font-size: 0.6875rem;
    line-height: 1.38;
    color: #16181d;
    box-shadow: 0 1px 1px rgb(0 0 0 / 0.09);
    /* Die Uhrzeit sitzt in der letzten Zeile. Der Freiraum verhindert,
       dass der Text sie ueberlaeuft. Etwas mehr als die Uhrzeit breit ist,
       sonst stossen Satzende und Uhrzeit in breiten Blasen aneinander. */
    padding-inline-end: 3rem;
  }

  .chat-blase-links {
    background: #fff;
    border-start-start-radius: 0.15rem;
  }

  /* Die Farbe der eigenen Blase kommt aus der Marke, nicht aus dem
     Messenger: der Verlauf ist eine Darstellung, keine Nachbildung. */
  .chat-blase-rechts {
    background: var(--color-accent-soft);
    border-start-end-radius: 0.15rem;
  }

  .chat-meta {
    position: absolute;
    inset-block-end: 0.28rem;
    inset-inline-end: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.16rem;
    font-size: 0.5rem;
    color: #8b9099;
  }

  .chat-haken {
    width: 0.6rem;
    color: #2f6df6;
  }

  /* --- Tippanzeige ------------------------------------------------------ */
  .chat-tippen {
    display: inline-flex;
    align-items: center;
    gap: 0.16rem;
    padding: 0.42rem 0.6rem;
    background: #fff;
    border-start-start-radius: 0.15rem;
  }

  .chat-punkt {
    width: 0.26rem;
    height: 0.26rem;
    border-radius: 999px;
    background: #9aa0a8;
  }

  /* Die Tippanzeige gehoert zum Ablauf und sonst nirgendwohin. Ohne diese
     Regel stuenden ohne JavaScript drei Punkte ueber einer Nachricht, die
     laengst da ist. */
  .chat-tippzeile {
    opacity: 0;
    grid-template-rows: 0fr;
  }

  /* --- Eingabezeile ----------------------------------------------------- */
  .chat-eingabe {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    /* Unten mehr Luft: dort sitzt auf dem Geraet der Bedienbalken. */
    padding: 0.45rem 0.6rem 1.15rem;
    background: #f6f2ee;
    border-top: 1px solid rgb(0 0 0 / 0.07);
  }

  .chat-feld {
    flex: 1;
    padding: 0.34rem 0.7rem;
    border-radius: 999px;
    background: #fff;
    font-size: 0.6875rem;
    color: #9aa0a8;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.07);
  }

  .chat-senden {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.35rem;
    height: 1.35rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
  }

  .chat-senden svg { width: 0.7rem; }

  /* Der EINZIGE Unterschied zwischen Telefon und Fenster: der Platz fuer
     den Bedienbalken am unteren Rand des Geraets. Blasen, Farben, Schrift,
     Kopf und Tippanzeige sind ueberall auf der Seite dieselben. */
  .chat-in-fenster .chat-eingabe {
    padding-block-end: 0.55rem;
  }

  /* ======================================================================
     Der Ablauf

     Ausgangslage OHNE Skript: alles steht fertig da. Erst wenn ein Skript
     laeuft, traegt es `data-js` an das Dokument, und dann erst wird vor dem
     Start versteckt. So bleibt die Seite ohne JavaScript vollstaendig.

     `data-laeuft` setzt der Beobachter in Base.astro, sobald der Verlauf zu
     sehen ist. Ohne das waere er vorbei, bevor jemand hinschaut.
     ====================================================================== */
  @media (prefers-reduced-motion: no-preference) {
    .chat[data-laeuft] .chat-zeile:not(.chat-tippzeile) {
      animation: blase-herein 0.34s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: var(--ab);
    }

    /* Die Tippanzeige kommt UND geht wieder: sie waechst auf, bleibt fuer
       ihre Dauer stehen und verschwindet, wenn die Antwort erscheint.
       Deshalb eine eigene Kurve statt `both`. */
    .chat[data-laeuft] .chat-tippzeile {
      animation: tippen-zeigen var(--dauer) linear both;
      animation-delay: var(--ab);
    }

    .chat[data-laeuft] .chat-tippzeile .chat-punkt {
      animation: punkt-huepfen 1.1s ease-in-out infinite;
    }

    .chat[data-laeuft] .chat-punkt:nth-child(2) { animation-delay: 0.16s; }
    .chat[data-laeuft] .chat-punkt:nth-child(3) { animation-delay: 0.32s; }

    /* Der Wechsel von einem Verlauf zum naechsten. Der abgehende schiebt
       nach links weg, waehrend der naechste von rechts hereinkommt, so wie
       beim Wechsel zwischen zwei Chats auf dem Geraet.

       Zwei Animationen an einem Element: die zweite darf NICHT rueckwaerts
       fuellen, sonst wuerde sie den Zustand schon waehrend des Hereinkommens
       ueberschreiben. Deshalb `forwards` und nicht `both`. */
    .chat[data-laeuft] .chat-teil {
      animation: schirm-herein var(--wechsel) cubic-bezier(0.22, 1, 0.36, 1) var(--von) both;
    }

    /* Der letzte Verlauf bleibt stehen. Ein leerer Schirm am Ende waere
       das Gegenteil der Aussage. */
    .chat[data-laeuft] .chat-teil:not(.chat-letzte) {
      animation:
        schirm-herein var(--wechsel) cubic-bezier(0.22, 1, 0.36, 1) var(--von) both,
        schirm-hinaus var(--wechsel) cubic-bezier(0.5, 0, 0.9, 0.4) var(--bis) forwards;
    }

    /* Vor dem Start ist nichts zu sehen. Ohne das blitzte der fertige
       Verlauf einmal auf, bevor er sich zurueckstellt. */
    :global(html[data-js]) .chat:not([data-laeuft]) .chat-zeile {
      opacity: 0;
      grid-template-rows: 0fr;
    }

    :global(html[data-js]) .chat:not([data-laeuft]) .chat-teil {
      opacity: 0;
      visibility: hidden;
    }
  }

  /* Ohne Bewegung steht der Verlauf sofort da, nur die Tippanzeigen
     entfallen: sie ergeben ohne Ablauf keinen Sinn. Mehrere Verlaeufe
     koennen einander ohne Bewegung nicht abloesen, es bleibt also der
     Ruhezustand von oben: der letzte Verlauf. Was in den anderen passiert
     ist, steht als Text daneben. */
  @media (prefers-reduced-motion: reduce) {
    .chat-tippzeile {
      display: none;
    }
  }

  @keyframes blase-herein {
    from {
      opacity: 0;
      grid-template-rows: 0fr;
      margin-block-start: 0;
      transform: translateY(0.4rem) scale(0.97);
    }
    60% {
      grid-template-rows: 1fr;
      margin-block-start: 0.3rem;
    }
    to {
      opacity: 1;
      grid-template-rows: 1fr;
      margin-block-start: 0.3rem;
      transform: none;
    }
  }

  /* Die Tippanzeige kommt UND geht: sie waechst auf, bleibt stehen und
     klappt wieder zu, wenn die Antwort erscheint. */
  @keyframes tippen-zeigen {
    0% { opacity: 0; grid-template-rows: 0fr; margin-block-start: 0; }
    14% { opacity: 1; grid-template-rows: 1fr; margin-block-start: 0.3rem; }
    86% { opacity: 1; grid-template-rows: 1fr; margin-block-start: 0.3rem; }
    100% { opacity: 0; grid-template-rows: 0fr; margin-block-start: 0; }
  }

  @keyframes punkt-huepfen {
    0%, 60%, 100% { transform: none; opacity: 0.55; }
    30% { transform: translateY(-0.16rem); opacity: 1; }
  }

  /* `visibility` springt nicht in der Mitte um, sondern gilt fuer die
     gesamte Laufzeit, sobald ein Ende sichtbar ist. Genau deshalb steht es
     hier: der Schirm ist waehrend der ganzen Bewegung da und davor bzw.
     danach vollstaendig weg, auch fuer die Maus. */
  @keyframes schirm-herein {
    from { opacity: 0; visibility: hidden; transform: translateX(12%); }
    to { opacity: 1; visibility: visible; transform: none; }
  }

  @keyframes schirm-hinaus {
    from { opacity: 1; visibility: visible; transform: none; }
    to { opacity: 0; visibility: hidden; transform: translateX(-12%); }
  }
</style>
