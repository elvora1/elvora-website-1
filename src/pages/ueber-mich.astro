---
import Base from '~/layouts/Base.astro';
import Auftakt from '~/components/Auftakt.astro';
import StoryPanel from '~/components/StoryPanel.astro';
import Band from '~/components/Band.astro';
import Liste from '~/components/Liste.astro';
import Portrait from '~/components/Portrait.astro';
import Button from '~/components/Button.astro';
import WhatsappCta from '~/components/WhatsappCta.astro';
import { cta, address, owner, contactLinks } from '~/config/site';

/**
 * Was der Kunde davon hat, dass ich aus dem Handwerk komme.
 * Bewusst als Nutzen formuliert, nicht als Lebenslauf.
 */
const vorteile = [
  {
    titel: 'Sie müssen mir nichts erklären',
    text: 'Ich kenne den Alltag von Betrieben, in denen der Inhaber mitarbeitet: dass ein Notfall den Tagesplan sprengt und der Termin um acht nicht immer um acht anfängt. Das spart Ihnen die Hälfte des ersten Gesprächs.',
  },
  {
    titel: 'Ich baue nichts, was im Alltag stört',
    text: 'Ein System, das drei zusätzliche Klicks kostet, wird nach zwei Wochen nicht mehr benutzt. Ich kenne den Unterschied zwischen einer schönen Lösung und einer, die neben der Arbeit übrig bleibt.',
  },
  {
    titel: 'Sie haben mit mir zu tun, nicht mit einem Team',
    text: 'Kein Projektleiter, der weitergibt, was Sie gesagt haben. Wer das Angebot macht, macht auch die Arbeit und geht ans Telefon.',
  },
];

/** Arbeitsweise: Aussagen, an denen man mich messen kann. */
const grundsaetze = [
  {
    titel: 'Ich sage auch, wenn etwas nichts bringt',
    text: 'Wenn Ihr Problem nicht mit einer Website zu lösen ist, sage ich das. Ein Auftrag, der nichts bewirkt, kostet mich langfristig mehr, als er einbringt.',
  },
  {
    titel: 'Kein Fachchinesisch',
    text: 'Ich erkläre alles so, dass Sie es ohne Nachfragen verstehen. Keine Abkürzungen, keine Begriffe, die Sie erst nachschlagen müssen. Wenn etwas unklar bleibt, liegt das an mir, nicht an Ihnen.',
  },
  {
    titel: 'Sie behalten alles in der Hand',
    text: 'Zugänge, Dateien, Domain: alles läuft auf Sie. Sie sind an mich gebunden, weil es passt, nicht weil Sie nicht wegkommen.',
  },
];

const belege = [owner.trade, `Aus ${address.city}`, 'Seit 2023 selbstständig'];
---

<Base
  title="Über mich"
  description="Luan Qerkini von Elvora aus Essen: zuständig für Sichtbarkeit und Automatisierung bei Betrieben, in denen der Inhaber mitarbeitet."
  breadcrumbs={[{ label: 'Über mich' }]}
  kopfFarbe="#1d2140"
>
  {/* ========== Auftakt ========== */}
  <Auftakt
    kennung="Der Mensch dahinter"
    zeilen={['Ein Name.', 'Eine Nummer.', 'Ein Ansprechpartner.']}
    intro={`Mein Name ist ${owner.fullName}, gelernter ${owner.trade}. Deshalb muss man mir nicht erklären, wie ein Betrieb von innen aussieht.`}
    cta={{ href: cta.primary.href, label: cta.primary.label }}
    neben={{ href: contactLinks.whatsapp, label: 'Oder direkt auf WhatsApp schreiben', extern: true }}
    belege={belege}
    color="#1d2140"
  />

  {/* ========== 01 Das Portrait ========== */}
  <StoryPanel
    index={1}
    label="Wer das ist"
    heading="Ich komme aus dem Handwerk"
    color="#f1ece6"
    ink="#191d21"
    texture="punkte"
  >
    <div class="portraet-raster">
      <div class="portraet-text">
        <p class="fliess">
          Der Inhaber arbeitet mit, das Telefon klingelt zur Unzeit, und der
          Papierkram bleibt für abends übrig. Ob Werkstatt, Praxis oder Kanzlei
          ändert daran wenig.
        </p>
        <p class="fliess-klein">
          Genau deshalb baue ich nichts, was im Alltag stört. Ich weiß, wie
          wenig Zeit für Zusatzaufwand übrig ist.
        </p>
      </div>

      <div class="portraet-bild hereinziehen">
        <Portrait alt={`${owner.fullName}, Inhaber von Elvora aus ${address.city}`} />
      </div>
    </div>
  </StoryPanel>

  {/* ========== 02 Der Weg ========== */}
  <StoryPanel
    index={2}
    label="Wie es dazu kam"
    heading="Erst aus Neugier, dann aus Ärger"
    color="#2b2f7a"
  >
    <p class="fliess">
      Irgendwann habe ich angefangen, mich abends mit Websites zu beschäftigen,
      dann mit Google, später mit Automatisierung. Zuerst aus Neugier.
    </p>

    <div slot="fuss" class="weg">
      <p class="weg-text">
        Dann, weil mir auffiel, wie viel davon in Betrieben ungenutzt liegen
        bleibt. Nicht aus Desinteresse, sondern weil niemand die Zeit hat, sich
        damit zu befassen.
      </p>
      <p class="weg-text">
        Gleichzeitig habe ich gesehen, wie Betriebe von Agenturen betreut
        werden, die deren Alltag nie erlebt haben. Da entstehen Websites mit
        Bildern aus dem Katalog und Texten über „ganzheitliche
        Lösungskompetenz". Wer gerade ein Problem hat, sucht etwas anderes.
      </p>
    </div>
  </StoryPanel>

  {/* ========== 03 Für wen ========== */}
  <StoryPanel
    index={3}
    label="Für wen ich arbeite"
    heading="Die Branche ist zweitrangig"
    color="#5c3491"
  >
    <p class="fliess">
      Praxen, Kanzleien, Studios, Dienstleister, Handwerksbetriebe,
      Einzelhändler. Das Muster ist überall dasselbe: Die Arbeit ist gut, die
      Kundschaft zufrieden, aber niemand hat Zeit für Sichtbarkeit und Abläufe.
    </p>

    <p slot="fuss" class="fliess-klein">
      Wenn Sie sich darin wiedererkennen, passt es.
    </p>
  </StoryPanel>

  {/* ========== Was das für Sie bedeutet ========== */}
  <Band
    ton="hell"
    kennung="Was das für Sie bedeutet"
    heading="Drei Dinge, die daraus folgen"
  >
    <Liste eintraege={vorteile} anordnung="spalten" />
  </Band>

  {/* ========== Woran Sie mich messen können ========== */}
  <Band
    ton="gedaempft"
    kennung="Woran Sie mich messen können"
    heading="Drei Zusagen, die ich einhalte"
    intro="Keine Werte-Seite. Drei Sätze, bei denen Sie merken würden, wenn ich mich nicht daran halte."
  >
    <Liste eintraege={grundsaetze} anordnung="reihen" geordnet />
  </Band>

  {/* ========== Abschluss ========== */}
  <Band ton="tief" kennung="Kennenlernen" heading="Lernen wir uns kennen" raum="md">
    <div class="schluss">
      <p class="schluss-text">
        Am einfachsten in einem kurzen Gespräch. Sie erzählen, wo es klemmt, ich
        sage Ihnen ehrlich, ob ich der Richtige dafür bin.
      </p>

      <div class="schluss-handlung">
        <Button href={cta.primary.href} size="lg" variant="aufFarbe" class="max-sm:w-full">
          {cta.primary.label}
        </Button>
        <p class="schluss-notiz">{cta.primary.note}</p>
        <WhatsappCta variant="inline" class="text-white/80" />
      </div>
    </div>
  </Band>
</Base>

<style>
  .fliess {
    margin: 0;
    max-width: 44ch;
    font-size: clamp(1.0625rem, 1.9vw, 1.5rem);
    line-height: 1.5;
    opacity: 0.92;
  }

  .fliess-klein {
    margin: 0;
    max-width: 52ch;
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.6;
    opacity: 0.8;
  }

  /* --- Portraetflaeche --------------------------------------------------- */
  .portraet-raster {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  @media (width >= 64rem) {
    .portraet-raster {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
    }
  }

  .portraet-text {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .portraet-bild :global(> div) {
    border-radius: 0;
    background: transparent;
  }

  .portraet-bild :global(img) {
    aspect-ratio: 4 / 5;
    width: 100%;
    object-fit: cover;
  }

  /* Auf schmalen Geraeten steht das Bild oben und bleibt klein genug, dass
     der Text darunter noch auf die Flaeche passt. */
  @media (width < 64rem) {
    .portraet-bild {
      order: -1;
      max-width: 13rem;
    }

    .portraet-bild :global(img) {
      aspect-ratio: 1 / 1;
    }
  }

  /* --- Der Weg ----------------------------------------------------------- */
  .weg {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  @media (width >= 48rem) {
    .weg {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .weg-text {
    margin: 0;
    font-size: clamp(0.9375rem, 1.3vw, 1.0625rem);
    line-height: 1.6;
    opacity: 0.85;
  }

  /* --- Abschluss --------------------------------------------------------- */
  .schluss {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  @media (width >= 48rem) {
    .schluss {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }

  .schluss-text {
    margin: 0;
    max-width: 44ch;
    font-size: clamp(1.0625rem, 1.5vw, 1.1875rem);
    line-height: 1.6;
    opacity: 0.9;
  }

  .schluss-handlung {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .schluss-notiz {
    margin: 0;
    font-size: 0.875rem;
    opacity: 0.7;
  }
</style>
