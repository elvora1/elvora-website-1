---
import Texture from './Texture.astro';

/**
 * Eine Vollbildfläche der Story.
 *
 * Aufbau nach dem Vorbild: Kennzeichnung oben, Trennlinie, sehr große
 * Überschrift, Trennlinie, Inhalt, und was unten stehen soll, wird nach
 * unten gedrückt. Die Flächen bleiben beim Scrollen stehen, die nächste
 * kippt von unten herein.
 *
 * Die Bewegung läuft über `position: sticky` und `animation-timeline: view()`,
 * nicht über GSAP: kein JavaScript, kein Nachrechnen bei jedem Scrollschritt.
 */
interface Props {
  /** Laufende Nummer, wird zweistellig ausgegeben. */
  index: number;
  /** Kennzeichnung neben der Nummer. */
  label: string;
  /** Die große Überschrift. */
  heading: string;
  /** Hintergrundfarbe der Fläche. */
  color: string;
  /** Schriftfarbe. Standard ist Weiß. */
  ink?: string;
  /** Überschriftsebene. Genau eine Fläche trägt die h1. */
  as?: 'h1' | 'h2';
  /** Feinere Schraffur auf hellen Flächen. */
  texture?: 'schraffur' | 'punkte' | 'keine';
}

const {
  index,
  label,
  heading,
  color,
  ink = '#ffffff',
  as: Tag = 'h2',
  texture = 'schraffur',
}: Props = Astro.props;

const nummer = String(index).padStart(2, '0');
---

<section
  class="platte"
  style={`--grund:${color};--tinte:${ink};z-index:${index}`}
  aria-label={label}
>
  <div class="platte-inner">
    {texture !== 'keine' && <Texture variant={texture} />}

    <div class="platte-kopf">
      <p class="platte-kennung kennung">
        {nummer} <span aria-hidden="true">—</span> {label}
      </p>

      {/* Genau EINE Linie, direkt unter der Kennung, als Kapitelmarke.
          Eine zweite unter der Schlagzeile rahmte die Aussage ein wie ein
          Formularfeld. */}
      <hr />

      <Tag class="schlag einblenden">{heading}</Tag>
    </div>

    <div class="platte-koerper einblenden" style="--verzug:1">
      <slot />
    </div>

    <div class="platte-fuss">
      <slot name="fuss" />
    </div>
  </div>
</section>

<style>
  .platte {
    position: relative;
    width: 100%;
    overflow: hidden;
    background: var(--grund);
    color: var(--tinte);
  }

  /* Bildschirmhoch MINUS Kopfleiste, sonst rutscht der Fuss der Flaeche um
     genau deren Hoehe unter die Falz. */
  .platte-inner {
    position: relative;
    display: flex;
    min-height: calc(100svh - var(--kopf-hoehe));
    width: 100%;
    flex-direction: column;
    gap: clamp(1.25rem, 2.5vw, 2rem);
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 4rem) clamp(2rem, 3.5vw, 3.25rem);
    transform-origin: bottom left;
    will-change: transform;
  }

  .platte-kopf,
  .platte-koerper,
  .platte-fuss {
    position: relative;
    z-index: 10;
  }

  .platte-kopf {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 2vw, 1.75rem);
  }

  .platte-kennung {
    margin: 0;
    opacity: 0.7;
  }

  .platte hr {
    margin: 0;
    border: 0;
    border-top: 1px solid currentColor;
    opacity: 0.32;
  }

  /* Bewusst keine Grossbuchstaben: im Deutschen laufen die Woerter zu lang
     und werden in Versalien schwerer lesbar.

     Zeilenhoehe 1.04 statt 0.9: Ae, Oe und Ue tragen ihre Punkte oberhalb
     der Versalhoehe, und Unterlaengen wie in "gefunden" brauchen Platz.
     Enger gesetzt stossen die Zeilen ineinander. Die Wirkung kommt aus der
     Groesse und aus der Schrift, nicht aus dem Zusammenquetschen. */
  .schlag {
    margin: 0;
    color: var(--tinte);
    font-size: clamp(2.25rem, 6vw, 5rem);
    font-weight: 400;
    line-height: 1.04;
    letter-spacing: -0.015em;
    max-width: 16ch;
    text-wrap: balance;
  }

  .platte-koerper {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  /* Drueckt den Abschluss ans untere Ende der Flaeche. */
  .platte-fuss {
    margin-top: auto;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .platte-fuss:empty {
    display: none;
  }

  /* --- Der Stapel, erst ab Tablet -------------------------------------
     Bewusst einfach gehalten: die Flaeche selbst klebt oben und ist genau
     bildschirmhoch. Ein Versuch mit ueberhohem Fluss und klebendem Inhalt
     brachte laengere Verweildauer, hinterliess aber leeren Raum unter der
     Flaeche. Kurz und sauber schlaegt lang und kaputt. */
  @media (width >= 48rem) and (prefers-reduced-motion: no-preference) {
    .platte {
      position: sticky;
      top: var(--kopf-hoehe);
      height: calc(100svh - var(--kopf-hoehe));
    }

    .platte-inner {
      height: 100%;
      min-height: 0;
    }

    /* Jede Kapitelflaeche folgt auf etwas -- die erste auf den Auftakt --
       und kippt deshalb ein. Der fruehere Ausschluss ueber `:first-of-type`
       ist entfallen: der zaehlt nach Elementtyp, nicht nach Klasse, und
       haette hier die falsche Flaeche erwischt. */
    @supports (animation-timeline: view()) {
      .platte .platte-inner {
        animation: hereinkippen linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 92%;
      }
    }
  }

  @keyframes hereinkippen {
    from {
      transform: rotate(20deg);
    }
    to {
      transform: rotate(0deg);
    }
  }
</style>
