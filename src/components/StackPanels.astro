---
import { services } from '~/config/site';

/**
 * Vier Leistungen als gestapelte Vollbildflächen.
 *
 * Beim Scrollen bleibt jede Fläche stehen, während die nächste von unten
 * hereinkippt und sich in die Waagerechte dreht. Vorbild war eine
 * GSAP-Umsetzung mit ScrollTrigger.
 *
 * Hier läuft es ohne JavaScript:
 *  - `position: sticky` haelt die Flaeche stehen, statt sie zu "pinnen"
 *  - `animation-timeline: view()` treibt die Drehung ueber die Scrollposition
 *
 * Das spart rund 35 kB komprimiertes JavaScript gegenueber GSAP samt
 * ScrollTrigger, und der Browser rechnet die Bewegung selbst, statt sie bei
 * jedem Scrollereignis nachzustellen.
 *
 * Rueckfallebene: Kann ein Browser keine scrollgesteuerten Animationen,
 * stapeln sich die Flaechen ohne Drehung. Auf Mobilgeraeten und bei
 * reduzierter Bewegung laufen sie ohnehin schlicht untereinander, weil
 * feststehende Vollbildflaechen dort mehr stoeren als sie bringen.
 */

/** Je Leistung eine Farbwelt aus dem Markenverlauf. */
const flaechen = [
  { grund: '#2b2f7a', text: '#ffffff', linie: 'rgb(255 255 255 / 0.28)' },
  { grund: '#5c3491', text: '#ffffff', linie: 'rgb(255 255 255 / 0.28)' },
  { grund: '#a63082', text: '#ffffff', linie: 'rgb(255 255 255 / 0.3)' },
  { grund: '#c4472f', text: '#ffffff', linie: 'rgb(255 255 255 / 0.32)' },
];
---

<div class="stapel">
  {
    services.map((service, i) => {
      const f = flaechen[i % flaechen.length]!;
      return (
        <section
          class="platte"
          style={`--grund:${f.grund};--text:${f.text};--linie:${f.linie};z-index:${i + 1}`}
          aria-label={service.label}
        >
          <div class="platte-inner">
            <p class="nummer">
              {String(i + 1).padStart(2, '0')} <span aria-hidden="true">—</span> {service.label}
            </p>

            <hr />

            <h3 class="schlag">{service.benefit}</h3>

            <hr />

            <div class="fuss">
              <p class="text">{service.teaser}</p>
              <a class="weiter" href={service.href}>
                Mehr dazu
                <svg
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M4 10h11M11 6l4 4-4 4" />
                </svg>
              </a>
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<style>
  .stapel {
    /* Kein overflow:hidden hier: das wuerde sticky ausser Kraft setzen. */
    position: relative;
    width: 100%;
  }

  .platte {
    position: relative;
    width: 100%;
    background: var(--grund);
    color: var(--text);
  }

  .platte-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1.25rem, 4vw, 4rem);
    min-height: 100%;
  }

  .nummer {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .platte hr {
    margin: 0;
    border: 0;
    border-top: 1px solid var(--linie);
  }

  .schlag {
    margin: 0;
    color: var(--text);
    font-size: clamp(2.25rem, 7.5vw, 6rem);
    line-height: 0.94;
    letter-spacing: -0.04em;
    max-width: 20ch;
  }

  .fuss {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
    margin-top: auto;
  }

  .text {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(1rem, 1.6vw, 1.25rem);
    opacity: 0.86;
  }

  .weiter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid currentColor;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .weiter svg {
    width: 1.125rem;
    height: 1.125rem;
    transition: transform 0.2s;
  }

  .weiter:hover svg {
    transform: translateX(3px);
  }

  /* --- Der Stapel selbst, erst ab Tablet ------------------------------- */
  @media (width >= 48rem) and (prefers-reduced-motion: no-preference) {
    .platte {
      position: sticky;
      top: 0;
      height: 100svh;
      overflow: hidden;
    }

    .platte-inner {
      height: 100%;
      transform-origin: bottom left;
      will-change: transform;
    }

    /* Scrollgesteuerte Drehung. Ohne Unterstuetzung passiert schlicht
       nichts und die Flaechen stapeln sich ohne Kippbewegung. */
    @supports (animation-timeline: view()) {
      .platte:not(:first-child) .platte-inner {
        animation: hereinkippen linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 92%;
      }
    }
  }

  @keyframes hereinkippen {
    from {
      transform: rotate(14deg) translateY(4%);
    }
    to {
      transform: rotate(0deg) translateY(0);
    }
  }
</style>
