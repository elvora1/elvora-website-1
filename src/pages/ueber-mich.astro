---
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import Texture from '~/components/Texture.astro';
import Portrait from '~/components/Portrait.astro';
import Button from '~/components/Button.astro';
import CtaBand from '~/components/CtaBand.astro';
import WhatsappCta from '~/components/WhatsappCta.astro';
import { cta, address, owner } from '~/config/site';

/**
 * Was der Kunde davon hat, dass ich aus dem Handwerk komme.
 * Bewusst als Nutzen formuliert, nicht als Lebenslauf.
 */
const advantages = [
  {
    title: 'Sie müssen mir nichts erklären',
    text: 'Ich kenne den Alltag von Betrieben, in denen der Inhaber mitarbeitet: dass ein Notfall den Tagesplan sprengt und der Termin um acht nicht immer um acht anfängt. Das spart Ihnen die Hälfte des ersten Gesprächs.',
  },
  {
    title: 'Ich baue nichts, was im Alltag stört',
    text: 'Ein System, das drei zusätzliche Klicks kostet, wird nach zwei Wochen nicht mehr benutzt. Ich kenne den Unterschied zwischen einer schönen Lösung und einer, die neben der Arbeit übrig bleibt.',
  },
  {
    title: 'Sie haben mit mir zu tun, nicht mit einem Team',
    text: 'Kein Projektleiter, der weitergibt, was Sie gesagt haben. Wer das Angebot macht, macht auch die Arbeit und geht ans Telefon.',
  },
];

/** Arbeitsweise: Aussagen, an denen man mich messen kann. */
const principles = [
  {
    title: 'Ich sage auch, wenn etwas nichts bringt',
    text: 'Wenn Ihr Problem nicht mit einer Website zu lösen ist, sage ich das. Ein Auftrag, der nichts bewirkt, kostet mich langfristig mehr, als er einbringt.',
  },
  {
    title: 'Kein Fachchinesisch',
    text: 'Ich erkläre alles so, dass Sie es ohne Nachfragen verstehen. Keine Abkürzungen, keine Begriffe, die Sie erst nachschlagen müssen. Wenn etwas unklar bleibt, liegt das an mir, nicht an Ihnen.',
  },
  {
    title: 'Sie behalten alles in der Hand',
    text: 'Zugänge, Dateien, Domain: alles läuft auf Sie. Sie sind an mich gebunden, weil es passt, nicht weil Sie nicht wegkommen.',
  },
];
---

<Base
  title="Über mich"
  description="Luan Qerkini von Elvora aus Essen: zuständig für Sichtbarkeit und Automatisierung bei Betrieben, in denen der Inhaber mitarbeitet."
  breadcrumbs={[{ label: 'Über mich' }]}
  kopfFarbe="#1d2140"
>
  <section class="ueber-tafel">
    <Texture variant="schraffur" />

    <div class="container-content ueber-inner">
      <Breadcrumbs trail={[{ label: 'Über mich' }]} tone="inverse" />

      <div class="ueber-raster">
        <div class="ueber-text">
          <p class="ueber-eyebrow kennung">Der Mensch dahinter</p>
          <hr />
          <h1 class="ueber-schlag">
            Ich komme aus dem Handwerk. Deshalb muss man mir nichts erklären.
          </h1>
          <p class="ueber-intro">
            Mein Name ist {owner.fullName}, gelernter {owner.trade}. Deshalb
            weiß ich, wie ein Betrieb von innen aussieht: Der Inhaber arbeitet
            mit, das Telefon klingelt zur Unzeit, und der Papierkram bleibt für
            abends übrig. Ob Werkstatt, Praxis oder Kanzlei ändert daran wenig.
          </p>
        </div>

        <div class="ueber-bild">
          <Portrait alt={`${owner.fullName}, Inhaber von Elvora aus ${address.city}`} />
        </div>
      </div>
    </div>
  </section>

  {/* ===================== Der Weg dahin ===================== */}
  <Section>
    <div class="max-w-2xl">
      <h2 class="text-3xl md:text-4xl">Wie ich hier gelandet bin</h2>

      <div class="mt-6 flex flex-col gap-5 text-ink-muted">
        <p>
          Irgendwann habe ich angefangen, mich abends mit Websites zu
          beschäftigen, dann mit Google, später mit Automatisierung und
          künstlicher Intelligenz. Zuerst aus Neugier. Dann, weil mir auffiel,
          wie viel davon in Betrieben ungenutzt liegen bleibt. Nicht aus
          Desinteresse, sondern weil niemand die Zeit hat, sich damit zu
          befassen.
        </p>
        <p>
          Gleichzeitig habe ich gesehen, wie Betriebe von Agenturen betreut
          werden, die deren Alltag nie erlebt haben. Da entstehen dann Websites
          mit Bildern aus dem Katalog und Texten über „ganzheitliche
          Lösungskompetenz". Wer gerade ein Problem hat, sucht etwas anderes.
        </p>
        <p>
          Genau in dieser Lücke arbeite ich: Ich verstehe, wie ein Betrieb
          tickt, und kann die Technik bauen, die dahinter laufen muss.
        </p>
      </div>
    </div>
  </Section>

  {/* ===================== Was Sie davon haben ===================== */}
  <Section tone="subtle">
    <div class="max-w-2xl">
      <h2 class="text-3xl md:text-4xl">Was das für Sie bedeutet</h2>
    </div>

    <ul class="mt-12 grid gap-5 md:grid-cols-3">
      {
        advantages.map((item) => (
          <li class="rounded-card border border-border bg-surface p-7">
            <h3 class="text-lg">{item.title}</h3>
            <p class="mt-3 text-[0.9375rem] text-ink-muted">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* ===================== Für wen ich arbeite ===================== */}
  <Section>
    <div class="grid gap-12 md:grid-cols-2 md:gap-16">
      <div>
        <h2 class="text-3xl md:text-4xl">Für wen ich arbeite</h2>
        <p class="mt-4 text-ink-muted">
          Angefangen habe ich im Handwerk, weil ich es kenne. Geblieben ist davon
          das Verständnis für Betriebe, in denen der Inhaber mitarbeitet.
        </p>
        <p class="mt-4 text-ink-muted">
          Heute arbeite ich mit Praxen, Kanzleien, Studios, Dienstleistern,
          Handwerksbetrieben und Einzelhändlern. Das Muster ist überall
          dasselbe: Die Arbeit ist gut, die Kundschaft zufrieden, aber niemand
          hat die Zeit, sich um Sichtbarkeit und Abläufe zu kümmern.
        </p>
        <p class="mt-4 text-ink-muted">
          Wenn Sie sich darin wiedererkennen, ist Ihre Branche zweitrangig.
        </p>
      </div>

      <div class="rounded-card border border-border bg-surface-subtle p-7 md:p-8">
        <h3 class="text-lg">Woran Sie mich messen können</h3>
        <dl class="mt-6 flex flex-col gap-6">
          {
            principles.map((item) => (
              <div>
                <dt class="font-medium text-ink">{item.title}</dt>
                <dd class="mt-1.5 text-[0.9375rem] text-ink-muted">{item.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </Section>

  {/* ===================== Direkter Kontakt ===================== */}
  <Section tone="subtle" space="md">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl md:text-3xl">Lernen wir uns kennen</h2>
      <p class="mt-4 text-ink-muted">
        Am einfachsten in einem kurzen Gespräch. Sie erzählen, wo es klemmt, ich
        sage Ihnen ehrlich, ob ich der Richtige dafür bin.
      </p>

      <div class="mt-8 flex flex-col items-center gap-3">
        <Button href={cta.primary.href} size="lg" class="max-sm:w-full">
          {cta.primary.label}
        </Button>
        <p class="text-sm text-ink-faint">{cta.primary.note}</p>
      </div>

      <div class="mt-6 flex justify-center">
        <WhatsappCta variant="inline" class="text-ink-muted" />
      </div>
    </div>
  </Section>

  <CtaBand
    heading="Klingt das nach jemandem, mit dem Sie arbeiten würden?"
    text="Dann lassen Sie uns kurz sprechen. Ohne Vorbereitung, ohne Verpflichtung."
  />
</Base>

<style>
  .ueber-tafel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #1d2140;
    color: #fff;
  }

  .ueber-inner {
    position: relative;
    z-index: 10;
    padding-block: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem);
  }

  .ueber-raster {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: end;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  @media (width >= 64rem) {
    .ueber-raster {
      grid-template-columns: 1.35fr 1fr;
    }
  }

  .ueber-text {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .ueber-eyebrow {
    margin: 0;
    opacity: 0.85;
  }

  .ueber-tafel hr {
    margin: 0;
    border: 0;
    border-top: 1px solid rgb(255 255 255 / 0.24);
  }

  /* "Ich komme aus dem Handwerk" traegt kein Ae, Oe oder Ue, aber
     "erklaeren" hat eines, und der Titel der Seite ebenso. Deshalb hier
     dieselbe Zeilenhoehe wie auf allen anderen Tafeln. */
  .ueber-schlag {
    margin: 0;
    color: #fff;
    font-size: clamp(2rem, 4.6vw, 3.5rem);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.015em;
  }

  .ueber-intro {
    margin: 0;
    max-width: 54ch;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.55;
    opacity: 0.92;
  }

  /* Das Portraet bekommt Gewicht statt als kleine Kachel zu verschwinden. */
  .ueber-bild :global(> div) {
    border-radius: 0;
    background: transparent;
  }

  .ueber-bild :global(img) {
    aspect-ratio: 4 / 5;
    width: 100%;
    object-fit: cover;
  }
</style>
