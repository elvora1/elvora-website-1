---
import Base from './Base.astro';
import PanelHero from '~/components/PanelHero.astro';
import { legal } from '~/config/site';

/** Gemeinsamer Rahmen für Impressum und Datenschutzerklärung. */
interface Props {
  title: string;
  description: string;
  heading: string;
}

const { title, description, heading }: Props = Astro.props;
---

<Base
  title={title}
  description={description}
  breadcrumbs={[{ label: heading }]}
 
>
  <PanelHero
    eyebrow={`Stand: ${legal.lastUpdated}`}
    heading={heading}
    color="#1d2140"
    breadcrumbs={[{ label: heading }]}
    size="kompakt"
  />

  <div class="container-content py-14 md:py-18">
    <div class="prose-legal">
      <slot />
    </div>
  </div>
</Base>
