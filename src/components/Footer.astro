---
import Logo from './Logo.astro';
import {
  site,
  address,
  contact,
  contactLinks,
  openingHours,
  services,
  serviceArea,
} from '~/config/site';

const year = new Date().getFullYear();

const legalLinks = [
  { label: 'Impressum', href: '/impressum/' },
  { label: 'Datenschutz', href: '/datenschutz/' },
];
---

<footer class="border-t border-border bg-surface-subtle">
  <div class="container-content py-14 md:py-16">
    <div class="grid gap-10 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-4">
        <Logo />
        <p class="mt-4 max-w-xs text-[0.9375rem] text-ink-muted">
          Digitale Sichtbarkeit und weniger Bürokratie für Handwerks- und
          Dienstleistungsbetriebe in {serviceArea.display}.
        </p>
      </div>

      <div class="md:col-span-3">
        <h2 class="text-[0.8125rem] font-semibold uppercase tracking-wider text-ink-faint">
          Leistungen
        </h2>
        <ul class="mt-4 flex flex-col gap-2.5">
          {
            services.map((service) => (
              <li>
                <a
                  href={service.href}
                  class="text-[0.9375rem] text-ink-muted transition-colors hover:text-ink"
                >
                  {service.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-5">
        <h2 class="text-[0.8125rem] font-semibold uppercase tracking-wider text-ink-faint">
          Kontakt
        </h2>
        <address class="mt-4 flex flex-col gap-2.5 text-[0.9375rem] not-italic text-ink-muted">
          <span>
            {site.name}<br />
            {address.street}<br />
            {address.postalCode}&nbsp;{address.city}
          </span>
          <a href={contactLinks.tel} class="transition-colors hover:text-ink">
            {contact.phoneDisplay}
          </a>
          <a href={contactLinks.mail} class="transition-colors hover:text-ink">
            {contact.email}
          </a>
          <span class="text-ink-faint">{openingHours.display}</span>
        </address>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-4 border-t border-border pt-6 text-sm text-ink-faint sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {site.name}</p>
      <ul class="flex gap-6">
        {
          legalLinks.map((link) => (
            <li>
              <a href={link.href} class="transition-colors hover:text-ink">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
