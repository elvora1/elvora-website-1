---
/**
 * Ablauf in nummerierten Schritten.
 * Nimmt die Unsicherheit, was nach dem Erstgespräch eigentlich passiert.
 */
interface Props {
  items: Array<{ title: string; text: string }>;
}

const { items }: Props = Astro.props;
---

<ol class="grid gap-x-8 gap-y-10 md:grid-cols-2 lg:grid-cols-4">
  {
    items.map((item, index) => (
      <li class="relative">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-accent-soft ziffern text-sm font-medium text-accent">
          {index + 1}
        </span>
        <h3 class="mt-4 text-lg">{item.title}</h3>
        <p class="mt-2 text-[0.9375rem] text-ink-muted">{item.text}</p>
      </li>
    ))
  }
</ol>
