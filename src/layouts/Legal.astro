---
import Base from './Base.astro';
import Breadcrumbs from '~/components/Breadcrumbs.astro';
import { legal } from '~/config/site';

/** Gemeinsamer Rahmen für Impressum und Datenschutzerklärung. */
interface Props {
  title: string;
  description: string;
  heading: string;
}

const { title, description, heading }: Props = Astro.props;
---

<Base title={title} description={description}>
  <section class="border-b border-border bg-surface-subtle">
    <div class="container-content py-10 md:py-12">
      <Breadcrumbs trail={[{ label: heading }]} />
      <h1 class="mt-8 text-3xl md:text-4xl">{heading}</h1>
      <p class="mt-3 text-sm text-ink-faint">Stand: {legal.lastUpdated}</p>
    </div>
  </section>

  <div class="container-content py-14 md:py-18">
    <div class="prose-legal">
      <slot />
    </div>
  </div>
</Base>
