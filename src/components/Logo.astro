---
import logo from '~/assets/logo.svg';

/**
 * Wortmarke aus der Original-SVG.
 *
 * Wird als Bild eingebunden statt inline: die Datei enthält Farbverläufe mit
 * eigenen Kennungen, und bei mehrfacher Einbindung auf einer Seite (Kopf-
 * und Fußbereich) käme es sonst zu doppelten Kennungen im Dokument.
 * Die Datei ist rund 3 kB groß und wird vom Browser einmal geladen und
 * danach zwischengespeichert.
 */
interface Props {
  /** Höhe in Pixeln. Die Breite ergibt sich aus dem Seitenverhältnis. */
  height?: number;
  class?: string;
}

const { height = 28, class: className = '' }: Props = Astro.props;

const ratio = logo.width / logo.height;
---

<img
  src={logo.src}
  width={Math.round(height * ratio)}
  height={height}
  alt="Elvora"
  class={className}
  style={`height:${height / 16}rem;width:auto`}
  loading="eager"
  decoding="async"
/>
