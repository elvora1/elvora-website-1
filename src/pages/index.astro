---
import Base from '~/layouts/Base.astro';
import Auftakt from '~/components/Auftakt.astro';
import StoryPanel from '~/components/StoryPanel.astro';
import Button from '~/components/Button.astro';
import Portrait from '~/components/Portrait.astro';
import {
  cta,
  services,
  automationModules,
  address,
  owner,
  contactLinks,
} from '~/config/site';

const title = 'Elvora: Mehr Anfragen für Betriebe in Essen';
const description =
  'Website, Google-Sichtbarkeit und automatisierte Abläufe für Betriebe und Selbstständige in Essen und im Ruhrgebiet. Fester Ansprechpartner statt Agentur-Apparat.';

/** Wo Aufträge im Alltag verloren gehen. Konkret, nicht abstrakt. */
const verluste = [
  {
    titel: 'Das Telefon klingelt',
    text: 'Sie sind beim Kunden, im Termin, in der Werkstatt. Der Anrufer probiert den nächsten Betrieb. Sie erfahren nie davon.',
  },
  {
    titel: 'Zwölf Nachrichten am Abend',
    text: 'Dazu vier Rückrufwünsche. Sie arbeiten sie nach Feierabend ab, oder eben nicht.',
  },
  {
    titel: 'Niemand findet Sie',
    text: 'Gesucht wird bei Google, angerufen wird einer der ersten drei Treffer. Stehen Sie dort nicht, existieren Sie nicht.',
  },
];

/** Belegzeile am Fuß des Auftakts, bis Google-Bewertungen vorliegen. */
const belege = [
  `Aus ${address.city}`,
  'Ein fester Ansprechpartner',
  'Antwort binnen 24 Stunden',
];
---

<Base title={title} description={description} kopfFarbe="#16193a">
  {/* ========== Auftakt: kein Kapitel, kein Zaehler ========== */}
  <Auftakt
    kennung={`Digitalagentur aus ${address.city}`}
    zeilen={['Gefunden.', 'Angerufen.', 'Beauftragt.']}
    intro="Die meisten Betriebe verlieren Aufträge nicht an die Konkurrenz, sondern an verpasste Anrufe und eine Website, die niemand findet. Ich bringe beides in Ordnung."
    cta={{ href: cta.primary.href, label: cta.primary.label }}
    neben={{ href: contactLinks.whatsapp, label: 'Oder direkt auf WhatsApp schreiben', extern: true }}
    belege={belege}
    color="#16193a"
  />

  {/* ========== 01 Das Problem ========== */}
  <StoryPanel
    index={1}
    label="Wo es klemmt"
    heading="Der Auftrag geht an den, der zuerst erreichbar war"
    color="#0f1124"
  >
    <p class="fliess">
      Nicht an den Besseren. Für einen Betrieb, in dem der Inhaber mitarbeitet,
      ist das eine unfaire Ausgangslage. Genau die lässt sich abstellen.
    </p>

    <div slot="fuss" class="spalten">
      {
        verluste.map((v, i) => (
          <div class="spalte einblenden" style={`--verzug:${i}`}>
            <p class="spalte-titel kennung">{v.titel}</p>
            <p class="spalte-text">{v.text}</p>
          </div>
        ))
      }
    </div>
  </StoryPanel>

  {/* ========== 02 bis 05 Die vier Leistungen ========== */}
  {
    services.map((service, i) => (
      <StoryPanel
        index={i + 2}
        label={service.label}
        heading={service.benefit}
        color={service.color}
      >
        <p class="fliess">{service.teaser}</p>

        {service.slug === 'automatisierung' && (
          <ul class="module">
            {automationModules.map((m, j) => (
              <li class="einblenden" style={`--verzug:${j}`}>
                {m.name}
              </li>
            ))}
          </ul>
        )}

        <div slot="fuss" class="abschluss">
          <a class="weiter" href={service.href}>
            {service.slug === 'automatisierung'
              ? 'Alle sieben Module ansehen'
              : `${service.label} im Detail`}
            <svg
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 10h11M11 6l4 4-4 4" />
            </svg>
          </a>
        </div>
      </StoryPanel>
    ))
  }

  {/* ========== 06 Der Mensch dahinter ========== */}
  <StoryPanel
    index={6}
    label="Der Mensch dahinter"
    heading="Ich komme aus dem Handwerk"
    color="#f1ece6"
    ink="#191d21"
    texture="punkte"
  >
    <p class="fliess">
      Mein Name ist {owner.fullName}, gelernter {owner.trade}. Deshalb weiß ich,
      wie ein Betrieb von innen aussieht: Der Inhaber arbeitet mit, das Telefon
      klingelt zur Unzeit, und der Papierkram bleibt für abends übrig. Ob
      Werkstatt, Praxis oder Kanzlei ändert daran wenig.
    </p>

    <div slot="fuss" class="portraet-zeile">
      <div class="portraet hereinziehen">
        <Portrait alt={`${owner.fullName}, Inhaber von Elvora aus ${address.city}`} />
      </div>
      <a class="weiter" href="/ueber-mich/">
        Mehr über mich
        <svg
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M4 10h11M11 6l4 4-4 4" />
        </svg>
      </a>
    </div>
  </StoryPanel>

  {/* ========== 07 Abschluss ========== */}
  <StoryPanel
    index={7}
    label="Loslegen"
    heading="Klingt das nach Ihrem Betrieb?"
    color="#16193a"
  >
    <p class="fliess">
      In einem kurzen Gespräch schauen wir, wo bei Ihnen gerade Anfragen verloren
      gehen. Ohne Vorbereitung, ohne Verpflichtung. Und wenn ich Ihnen nicht
      helfen kann, sage ich Ihnen das.
    </p>

    <div slot="fuss" class="abschluss">
      <div class="knopfgruppe">
        <Button href={cta.primary.href} size="lg" variant="aufFarbe" class="max-sm:w-full">
          {cta.primary.label}
        </Button>
        <p class="notiz">{cta.primary.note}</p>
      </div>

      <p class="notiz">
        Lieber schreiben?{' '}
        <a
          href={contactLinks.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="unterstrichen">Auf WhatsApp antwortet sofort meine KI-Assistenz</a
        >. Sie sehen sie also gleich in Aktion.
      </p>
    </div>
  </StoryPanel>
</Base>

<style>
  .fliess {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(1.0625rem, 1.9vw, 1.5rem);
    line-height: 1.5;
    opacity: 0.88;
  }

  .abschluss {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  .knopfgruppe {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .notiz {
    margin: 0;
    max-width: 46ch;
    font-size: 0.9375rem;
    opacity: 0.72;
  }

  .unterstrichen {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Spalten wie im Vorbild: umbrechend, gleichmaessig, mit Mindestbreite. */
  .spalten {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.5rem, 3vw, 3rem);
  }

  .spalte {
    min-width: 190px;
    flex: 1;
  }

  /* Groesse und Sperrung kommen aus der Utility `kennung`. */
  .spalte-titel {
    margin: 0 0 0.625rem;
  }

  .spalte-text {
    margin: 0;
    font-size: clamp(0.9375rem, 1.3vw, 1.0625rem);
    line-height: 1.55;
    opacity: 0.75;
  }

  .module {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .module li {
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0.375rem 0.875rem;
    font-size: 0.875rem;
    opacity: 0.85;
  }

  /* Ein Navigationsziel, kein Etikett und keine Aussage: bleibt deshalb im
     Fliesstextschnitt, nur halbfett. */
  .weiter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid currentColor;
    color: inherit;
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    font-weight: 600;
    text-decoration: none;
  }

  .weiter svg {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  .weiter:hover svg {
    transform: translateX(4px);
  }

  .portraet-zeile {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  .portraet {
    width: clamp(8rem, 14vw, 13rem);
  }

  .portraet :global(> div) {
    border-radius: 0;
    background: transparent;
  }

  .portraet :global(img) {
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }
</style>
