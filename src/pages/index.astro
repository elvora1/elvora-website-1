---
import Base from '~/layouts/Base.astro';
import Band from '~/components/Band.astro';
import Button from '~/components/Button.astro';
import Portrait from '~/components/Portrait.astro';
import Scramble from '~/components/Scramble.astro';
import Sterne from '~/components/Sterne.astro';
import ReviewBadge from '~/components/ReviewBadge.astro';
import Geraet from '~/components/Geraet.astro';
import Tippend from '~/components/Tippend.astro';
import Kanalkreise from '~/components/Kanalkreise.astro';
import Nachrichtenstapel from '~/components/Nachrichtenstapel.astro';
import {
  cta,
  services,
  address,
  owner,
  contactLinks,
  reviews,
  serviceArea,
} from '~/config/site';

const title = 'Elvora: Mehr Anfragen für Betriebe in Essen';
const description =
  'Website, Google-Sichtbarkeit und automatisierte Abläufe für Betriebe und Selbstständige in Essen und im Ruhrgebiet. Fester Ansprechpartner statt Agentur-Apparat.';

/** Wo Aufträge im Alltag verloren gehen. Konkret, nicht abstrakt. */
const verluste = [
  {
    titel: 'Das Telefon klingelt',
    text: 'Sie sind beim Kunden, im Termin, in der Werkstatt. Der Anrufer probiert den nächsten Betrieb. Sie erfahren nie davon.',
  },
  {
    titel: 'Zwölf Nachrichten am Abend',
    text: 'Dazu vier Rückrufwünsche. Sie arbeiten sie nach Feierabend ab, oder eben nicht.',
  },
  {
    titel: 'Niemand findet Sie',
    text: 'Gesucht wird bei Google, angerufen wird einer der ersten drei Treffer. Stehen Sie dort nicht, existieren Sie nicht.',
  },
];

/** Was hereinkommt, während der Betrieb arbeitet. */
const eingang = [
  {
    kanal: 'WhatsApp',
    zeit: '08:14',
    text: 'Guten Tag, ich bräuchte kurzfristig einen Termin. Geht diese Woche noch was?',
  },
  {
    kanal: 'Verpasster Anruf',
    zeit: '09:02',
    text: 'Angerufen, niemand erreicht. Die Assistenz hat nachgefasst und die Nummer notiert.',
  },
  {
    kanal: 'Kontaktformular',
    zeit: '11:37',
    text: 'Anfrage über die Website. Bereits beantwortet, Rückruf für 16 Uhr vereinbart.',
  },
];

/** Der Empfang, den man auf WhatsApp tatsächlich bekommt. */
const empfang = [
  { von: 'sie' as const, text: 'Guten Tag, hätten Sie diese Woche noch einen Termin frei?' },
  { von: 'wir' as const, text: 'Guten Tag! Ich bin die digitale Assistenz von Elvora. Worum geht es genau?' },
  { von: 'sie' as const, text: 'Wir bräuchten eine neue Website.' },
  { von: 'wir' as const, text: 'Danke. Ich gebe das an Luan weiter, er meldet sich heute noch bei Ihnen.' },
];

const wege = [
  { label: 'WhatsApp', href: contactLinks.whatsapp, symbol: 'chat' as const, extern: true },
  { label: 'Telefon', href: contactLinks.tel, symbol: 'telefon' as const },
  { label: 'E-Mail', href: contactLinks.mail, symbol: 'brief' as const },
  { label: 'Termin', href: cta.primary.href, symbol: 'kalender' as const },
];
---

<Base title={title} description={description}>
  {/* ===================== Aufschlag =====================
      Weiß, viel Luft, ein Blickfang. Alles, was die Landingpage-Regeln
      verlangen, steht hier ohne Scrollen: Nutzenaussage, Bewertungen,
      Haupt-CTA und ein sichtbar untergeordneter zweiter Weg. */}
  <section class="hero">
    <div class="container-content hero-inner">
      <p class="hero-kennung kennung">
        <Scramble text={`Digitalagentur aus ${address.city}`} />
      </p>

      <h1 class="hero-schlag">
        Ihr Betrieb wird <em>gefunden</em>, angerufen und beauftragt.
      </h1>

      <p class="hero-intro">
        Die meisten Betriebe verlieren Aufträge nicht an die Konkurrenz, sondern
        an verpasste Anrufe und eine Website, die niemand findet. Ich bringe
        beides in Ordnung.
      </p>

      <div class="hero-handlung">
        <Button href={cta.primary.href} size="lg" class="max-sm:w-full">
          {cta.primary.label}
        </Button>

        <a
          class="hero-neben"
          href={contactLinks.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
        >
          Oder direkt auf WhatsApp schreiben
          <svg
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 10h11M11 6l4 4-4 4" />
          </svg>
        </a>
      </div>

      <p class="hero-notiz">{cta.primary.note}</p>

      <div class="hero-beleg">
        <ReviewBadge />
        <p class="hero-ort kennung">
          Aus {address.city} · {serviceArea.display}
        </p>
      </div>
    </div>
  </section>

  {/* ===================== Wo es klemmt ===================== */}
  <Band
    ton="gedaempft"
    kennung="Wo es klemmt"
    heading="Der Auftrag geht an den, der zuerst erreichbar war"
    intro="Nicht an den Besseren. Für einen Betrieb, in dem der Inhaber mitarbeitet, ist das eine unfaire Ausgangslage. Genau die lässt sich abstellen."
  >
    <ul class="verluste">
      {
        verluste.map((v, i) => (
          <li class="verlust einblenden" style={`--verzug:${i}`}>
            <p class="verlust-titel kennung">{v.titel}</p>
            <p class="verlust-text">{v.text}</p>
          </li>
        ))
      }
    </ul>
  </Band>

  {/* ===================== Die vier Leistungen ===================== */}
  <Band
    ton="hell"
    kennung="Leistungen"
    heading="Vier Bausteine, einzeln oder zusammen"
    intro="Sie müssen nicht alles auf einmal angehen. Meistens beginnen wir dort, wo gerade am meisten Geld liegen bleibt."
  >
    <ul class="leistungen">
      {
        services.map((service, i) => (
          <li class="leistung einblenden" style={`--verzug:${i}`}>
            <a class="leistung-link" href={service.href}>
              <span class="leistung-nummer ziffern" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>

              <span class="leistung-text">
                <span class="leistung-label kennung">{service.label}</span>
                <span class="leistung-nutzen">{service.benefit}</span>
                <span class="leistung-teaser">{service.teaser}</span>
              </span>

              <svg
                class="leistung-pfeil"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 10h11M11 6l4 4-4 4" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </Band>

  {/* ===================== Was hereinkommt ===================== */}
  <Band
    ton="hell"
    kennung="Ein Vormittag"
    heading="So sieht ein Vormittag mit Assistenz aus"
    intro="Drei Anfragen, alle beantwortet, keine liegen geblieben. Sie waren in der Zeit bei Ihren Kunden."
  >
    <Nachrichtenstapel nachrichten={eingang} class="eingang" />
  </Band>

  {/* ===================== Die Vorführung ===================== */}
  <Band ton="gedaempft" kennung="Vorführung" heading="Schreiben Sie mir, und Sie sehen es selbst">
    <div class="vorfuehrung">
      <div class="vorfuehrung-text">
        <p>
          Auf WhatsApp empfängt Sie zuerst meine KI-Assistenz. Es ist dieselbe,
          die ich für Betriebe einrichte. Sie erleben also aus der
          Kundenperspektive, was Ihre eigene Kundschaft erleben würde, statt es
          sich aus einer Beschreibung vorstellen zu müssen.
        </p>
        <p>Sobald es persönlich wird, übernehme ich. Genau so würde es bei Ihnen auch laufen.</p>

        <Button
          href={contactLinks.whatsapp}
          variant="secondary"
          target="_blank"
          rel="noopener noreferrer"
          class="max-sm:w-full"
        >
          Auf WhatsApp schreiben
        </Button>
      </div>

      <div class="vorfuehrung-geraet hereinziehen">
        <Geraet art="handy" bildunterschrift="Schematische Darstellung">
          <ul class="chat">
            {
              empfang.map((n, i) => (
                <li class:list={['blase', n.von === 'wir' && 'blase-wir']}>
                  {i === empfang.length - 1 ? <Tippend text={n.text} dauer={2.4} /> : n.text}
                </li>
              ))
            }
          </ul>
        </Geraet>
      </div>
    </div>
  </Band>

  {/* ===================== Der Mensch dahinter ===================== */}
  <Band ton="hell" kennung="Der Mensch dahinter" heading="Ich komme aus dem Handwerk">
    <div class="mensch">
      <div class="mensch-text">
        <p>
          Mein Name ist {owner.fullName}, gelernter {owner.trade}. Deshalb weiß
          ich, wie ein Betrieb von innen aussieht: Der Inhaber arbeitet mit, das
          Telefon klingelt zur Unzeit, und der Papierkram bleibt für abends
          übrig. Ob Werkstatt, Praxis oder Kanzlei ändert daran wenig.
        </p>
        <p>
          Sie haben mit mir zu tun, nicht mit einem Team. Wer das Angebot macht,
          macht auch die Arbeit und geht ans Telefon.
        </p>

        <a class="mensch-weiter" href="/ueber-mich/">
          Mehr über mich
          <svg
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 10h11M11 6l4 4-4 4" />
          </svg>
        </a>
      </div>

      <div class="mensch-bild hereinziehen">
        <Portrait alt={`${owner.fullName}, Inhaber von Elvora aus ${address.city}`} />
      </div>
    </div>
  </Band>

  {/* ===================== Bewertungen ===================== */}
  {
    reviews.enabled && reviews.items.length > 0 && (
      <Band ton="gedaempft" kennung="Was Kunden sagen" heading="Bewertungen">
        <ul class="stimmen">
          {reviews.items.map((stimme, i) => (
            <li class="stimme einblenden" style={`--verzug:${i}`}>
              <Sterne wert={stimme.rating} groesse={1} />
              <p class="stimme-text">{stimme.text}</p>
              <p class="stimme-quelle">
                <span class="stimme-name">{stimme.author}</span>
                {stimme.business && <span class="stimme-betrieb">{stimme.business}</span>}
              </p>
            </li>
          ))}
        </ul>
      </Band>
    )
  }

  {/* ===================== Abschluss =====================
      Die einzige dunkle Flaeche der Seite. Genau deshalb faellt sie auf. */}
  <Band ton="tief" kennung="Loslegen" heading="Klingt das nach Ihrem Betrieb?">
    <div class="schluss">
      <div class="schluss-text">
        <p>
          In einem kurzen Gespräch schauen wir, wo bei Ihnen gerade Anfragen
          verloren gehen. Ohne Vorbereitung, ohne Verpflichtung. Und wenn ich
          Ihnen nicht helfen kann, sage ich Ihnen das.
        </p>

        <div class="schluss-wege">
          <p class="schluss-wege-titel kennung">Alle Wege zu mir</p>
          <Kanalkreise kanaele={wege} tone="inverse" />
        </div>
      </div>

      <div class="schluss-handlung">
        <Button href={cta.primary.href} size="lg" variant="aufFarbe" class="max-sm:w-full">
          {cta.primary.label}
        </Button>
        <p class="schluss-notiz">{cta.primary.note}</p>
      </div>
    </div>
  </Band>
</Base>

<style>
  /* ===================== Aufschlag ===================== */
  .hero {
    background: var(--color-surface);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
    padding-block: clamp(3.5rem, 9vw, 7.5rem) clamp(3.5rem, 8vw, 6rem);
    max-width: 60rem;
  }

  .hero-kennung {
    margin: 0;
    color: var(--color-ink-faint);
  }

  /* Die Groesse traegt hier alles. Instrument Serif hat keinen Fettschnitt,
     die Wirkung kommt aus Mass und Satz. */
  .hero-schlag {
    margin: 0;
    font-size: clamp(2.5rem, 6.5vw, 5rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    max-width: 17ch;
  }

  /* Ein einziges Wort kursiv. Instrument Serif hat einen sehr schoenen
     Kursivschnitt, und ein Akzent wirkt nur, wenn er allein steht. */
  .hero-schlag em {
    font-style: italic;
    color: var(--color-accent);
  }

  .hero-intro {
    margin: 0;
    max-width: 46ch;
    font-size: clamp(1.0625rem, 1.6vw, 1.25rem);
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .hero-handlung {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem 1.75rem;
    margin-top: clamp(0.5rem, 1.5vw, 1rem);
  }

  /* Der zweite Weg bleibt ein Textlink: flaechig waere er ein zweiter
     Haupt-CTA und wuerde dem ersten die Wirkung nehmen. */
  .hero-neben {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink-muted);
    font-size: 0.9375rem;
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 5px;
    transition: color 0.15s, text-decoration-color 0.15s;
  }

  .hero-neben:hover {
    color: var(--color-ink);
    text-decoration-color: var(--color-ink-faint);
  }

  .hero-neben svg {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  .hero-neben:hover svg {
    transform: translateX(3px);
  }

  .hero-notiz {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-ink-faint);
  }

  /* Social Proof ohne Scrollen. */
  .hero-beleg {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: clamp(1.25rem, 3vw, 2rem);
    padding-top: clamp(1.25rem, 3vw, 2rem);
    border-top: 1px solid var(--color-border);
    width: 100%;
  }

  .hero-ort {
    margin: 0;
    color: var(--color-ink-faint);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-kennung,
    .hero-schlag,
    .hero-intro,
    .hero-handlung,
    .hero-notiz,
    .hero-beleg {
      animation: aufsteigen 0.8s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }
    .hero-kennung { animation-delay: 0.05s; }
    .hero-schlag { animation-delay: 0.14s; }
    .hero-intro { animation-delay: 0.28s; }
    .hero-handlung { animation-delay: 0.38s; }
    .hero-notiz { animation-delay: 0.44s; }
    .hero-beleg { animation-delay: 0.52s; }
  }

  @keyframes aufsteigen {
    from { opacity: 0; transform: translateY(1rem); }
    to { opacity: 1; transform: none; }
  }

  /* ===================== Wo es klemmt ===================== */
  .verluste {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 48rem) {
    .verluste {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(2rem, 3.5vw, 3.5rem);
    }

    .verlust {
      padding-inline-start: clamp(1.25rem, 2vw, 2rem);
      border-inline-start: 1px solid var(--color-border);
    }

    .verlust:first-child {
      padding-inline-start: 0;
      border-inline-start: 0;
    }
  }

  @media (width < 48rem) {
    .verlust + .verlust {
      padding-top: 1.75rem;
      border-top: 1px solid var(--color-border);
    }
  }

  .verlust-titel {
    margin: 0 0 0.625rem;
    color: var(--color-accent);
  }

  .verlust-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  /* ===================== Leistungen =====================
     Zeilen mit Haarlinien statt Karten. Kein Rahmen, kein Schatten, keine
     Rundung: die Linie trennt, der Weissraum gliedert. */
  .leistungen {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .leistung {
    border-top: 1px solid var(--color-border);
  }

  .leistung:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .leistung-link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.875rem 1.25rem;
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    color: inherit;
    text-decoration: none;
  }

  @media (width >= 48rem) {
    .leistung-link {
      gap: 1rem 2.5rem;
      padding-inline: 0.5rem;
      transition: padding-inline 0.25s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .leistung-link:hover {
      padding-inline-start: 1.5rem;
    }
  }

  .leistung-nummer {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-ink-faint);
  }

  .leistung-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .leistung-label {
    color: var(--color-accent);
  }

  .leistung-nutzen {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 2.6vw, 1.875rem);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }

  .leistung-teaser {
    max-width: 52ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .leistung-pfeil {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    color: var(--color-ink-faint);
    transition: transform 0.2s, color 0.2s;
  }

  .leistung-link:hover .leistung-pfeil {
    transform: translateX(4px);
    color: var(--color-accent);
  }

  /* ===================== Vorführung ===================== */
  .vorfuehrung {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (width >= 48rem) {
    .vorfuehrung {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
    }
  }

  .vorfuehrung-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.125rem;
    max-width: 52ch;
  }

  .vorfuehrung-text p {
    margin: 0;
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  .chat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 3.5rem 0.875rem 1.25rem;
    list-style: none;
  }

  .blase {
    max-width: 88%;
    align-self: flex-start;
    border-radius: 0.875rem 0.875rem 0.875rem 0.25rem;
    background: var(--color-surface-subtle);
    padding: 0.5rem 0.75rem;
    font-size: 0.75rem;
    line-height: 1.45;
    color: var(--color-ink);
  }

  .blase-wir {
    align-self: flex-end;
    border-radius: 0.875rem 0.875rem 0.25rem;
    background: var(--color-accent);
    color: var(--color-accent-contrast);
  }

  /* Der Stapel war fuer dunkle Flaechen gebaut: helle Raender, abgedunkelte
     Karten. Auf Weiss dreht sich das um. */
  .eingang {
    max-width: 34rem;
  }

  .eingang :global(.stapel-karte) {
    border-color: var(--color-border);
    background: var(--color-surface-subtle);
    color: var(--color-ink);
  }

  .eingang :global(.stapel-symbol) {
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  .eingang :global(.stapel-karte:hover) {
    background: var(--color-surface);
    border-color: var(--color-border-strong);
  }

  /* ===================== Der Mensch ===================== */
  .mensch {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (width >= 48rem) {
    .mensch {
      grid-template-columns: minmax(0, 1fr) minmax(0, 18rem);
    }
  }

  .mensch-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.125rem;
    max-width: 52ch;
  }

  .mensch-text p {
    margin: 0;
    line-height: 1.65;
    color: var(--color-ink-muted);
  }

  .mensch-weiter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--color-border-strong);
    color: var(--color-ink);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: border-color 0.15s;
  }

  .mensch-weiter:hover {
    border-color: var(--color-accent);
  }

  .mensch-weiter svg {
    width: 1.125rem;
    height: 1.125rem;
    transition: transform 0.2s;
  }

  .mensch-weiter:hover svg {
    transform: translateX(3px);
  }

  .mensch-bild :global(> div) {
    border-radius: 0;
    background: transparent;
  }

  .mensch-bild :global(img) {
    aspect-ratio: 4 / 5;
    width: 100%;
    object-fit: cover;
  }

  @media (width < 48rem) {
    .mensch-bild {
      max-width: 13rem;
    }
  }

  /* ===================== Bewertungen ===================== */
  .stimmen {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 48rem) {
    .stimmen {
      grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
      gap: clamp(2rem, 3.5vw, 3.5rem);
    }

    .stimme {
      padding-inline-start: clamp(1.25rem, 2vw, 2rem);
      border-inline-start: 1px solid var(--color-border);
    }

    .stimme:first-child {
      padding-inline-start: 0;
      border-inline-start: 0;
    }
  }

  .stimme-text {
