---
import Base from '~/layouts/Base.astro';
import Section from '~/components/Section.astro';
import Button from '~/components/Button.astro';
import ReviewBadge from '~/components/ReviewBadge.astro';
import Texture from '~/components/Texture.astro';
import StackPanels from '~/components/StackPanels.astro';
import mark from '~/assets/mark.svg';
import CtaBand from '~/components/CtaBand.astro';
import { cta, serviceArea, address, reviews } from '~/config/site';

const title = 'Elvora: Mehr Anfragen für Handwerksbetriebe in Essen';
const description =
  'Website, Google-Sichtbarkeit und automatisierte Abläufe für SHK- und Handwerksbetriebe in Essen und im Ruhrgebiet. Fester Ansprechpartner statt Agentur-Apparat.';

/** Kurze Vertrauensanker. Bewusst schlicht, damit sie dem CTA nicht Konkurrenz machen. */
const trustMarkers = [
  `Aus ${address.city}, für ${serviceArea.display}`,
  'Ein fester Ansprechpartner, keine Hotline',
  'Antwort auf Anfragen binnen 24 Stunden',
];
---

<Base title={title} description={description}>
  {/* ===================== Erster Sichtbereich ===================== */}
  <section class="relative isolate overflow-hidden border-b border-border bg-surface">
    <Texture variant="raster" />

    {/* Bildmarke schneidet von rechts an. Ein Ausschnitt statt eines brav
        zentrierten Logos: die Marke haelt die Flaeche, ohne dem Text Platz
        wegzunehmen. Bewusst nur die Marke, kein Schriftzug: ein
        angeschnittenes Wort waere als Fragment lesbar. */}
    <img
      src={mark.src}
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute -right-40 top-1/2 z-0 hidden w-[38rem] -translate-y-1/2 rotate-[8deg] opacity-[0.09] lg:block xl:-right-28 xl:w-[44rem]"
    />

    <div class="container-content relative z-10 py-20 md:py-28 lg:py-32">
      <div class="max-w-4xl">
        <p
          class="font-display text-[0.8125rem] font-semibold uppercase tracking-[0.16em] text-accent"
        >
          Digitalagentur aus {address.city} · Schwerpunkt SHK
        </p>

        <h1 class="mt-7 text-[2.75rem] leading-[1.02] sm:text-6xl lg:text-[4.75rem]">
          Ihr Betrieb wird gefunden, angerufen und beauftragt
        </h1>

        <p class="mt-8 max-w-2xl text-lg text-ink-muted md:text-xl">
          Die meisten Handwerksbetriebe verlieren Aufträge nicht an die Konkurrenz,
          sondern an verpasste Anrufe und eine Website, die niemand findet. Ich
          bringe beides in Ordnung und halte Ihnen den Rücken frei.
        </p>

        {/* Genau EIN hervorgehobener CTA. Der zweite bleibt bewusst leise. */}
        <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
          <div class="flex flex-col items-start gap-2 max-sm:w-full">
            <Button href={cta.primary.href} size="lg" class="max-sm:w-full">
              {cta.primary.label}
            </Button>
            <p class="text-sm text-ink-faint">{cta.primary.note}</p>
          </div>
          <Button href={cta.secondary.href} variant="quiet">
            {cta.secondary.label}
          </Button>
        </div>

        {/* Social Proof ohne Scrollen sichtbar. Der Block entfällt vollständig,
            solange keine echten Bewertungen hinterlegt sind. */}
        {
          reviews.enabled && reviews.count > 0 && (
            <div class="mt-12">
              <ReviewBadge />
            </div>
          )
        }
      </div>
    </div>
  </section>

  {/* ===================== Vertrauensanker ===================== */}
  <div class="border-y border-border bg-surface-subtle">
    <div class="container-content py-5">
      <ul
        class="flex flex-col gap-3 text-sm text-ink-muted sm:flex-row sm:justify-center sm:gap-10"
      >
        {
          trustMarkers.map((marker) => (
            <li class="flex items-center gap-2.5">
              <svg
                viewBox="0 0 20 20"
                class="h-4 w-4 shrink-0 text-accent"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 10.5l4 4 8-9" />
              </svg>
              {marker}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  {/* ===================== Leistungen ===================== */}
  <Section space="md">
    <div class="max-w-2xl">
      <h2 class="text-3xl md:text-4xl">Was sich für Sie dadurch ändert</h2>
      <p class="mt-4 text-ink-muted">
        Vier Bausteine, die aufeinander aufbauen. Sie müssen nicht alle auf einmal
        angehen. Meistens beginnen wir dort, wo gerade am meisten liegen bleibt.
      </p>
    </div>
  </Section>

  {/* Gestapelte Vollbildflaechen. Traegt die vier Leistungen deutlich
      kraeftiger als eine Kachelreihe. */}
  <StackPanels />

  <CtaBand />
</Base>
