---
import Base from './Base.astro';
import Section from '~/components/Section.astro';
import Button from '~/components/Button.astro';
import PanelHero from '~/components/PanelHero.astro';
import { services } from '~/config/site';
import Faq from '~/components/Faq.astro';
import type { FaqItem } from '~/types';
import CtaBand from '~/components/CtaBand.astro';
import { cta } from '~/config/site';

/**
 * Gemeinsamer Bauplan aller Leistungsseiten.
 * Aufbau: Problem benennen, Nutzen versprechen, Ablauf zeigen, Fragen
 * ausräumen, zum Gespräch führen.
 */
interface Props {
  /** Kennung der Leistung, bestimmt die Farbwelt der Tafel. */
  slug: string;
  /** Fachbezeichnung, tritt klein und untergeordnet auf. */
  label: string;
  /** Nutzenaussage, das ist die H1. */
  benefit: string;
  /** Ein bis zwei Sätze unter der Überschrift. */
  intro: string;
  title: string;
  description: string;
  faq?: FaqItem[];
}

const { slug, label, benefit, intro, title, description, faq = [] }: Props = Astro.props;

const index = services.findIndex((s) => s.slug === slug);
const service = services[index];
const nummer = String(index + 1).padStart(2, '0');
---

<Base
  title={title}
  description={description}
  breadcrumbs={[{ label: 'Leistungen', href: '/leistungen/' }, { label }]}
  service={{ name: `${label}: ${benefit}`, description: intro }}
  faq={faq}
>
  <PanelHero
    eyebrow={`${nummer} — ${label}`}
    heading={benefit}
    intro={intro}
    color={service?.color}
    breadcrumbs={[{ label: 'Leistungen', href: '/leistungen/' }, { label }]}
  >
    <div class="mt-4 flex flex-col items-start gap-2">
      <Button href={cta.primary.href} size="lg" variant="aufFarbe" class="max-sm:w-full">
        {cta.primary.label}
      </Button>
      <p class="text-sm text-white/70">{cta.primary.note}</p>
    </div>
  </PanelHero>

  <slot />

  {
    faq.length > 0 && (
      <Section tone="default">
        <div class="max-w-3xl">
          <Faq items={faq} />
        </div>
      </Section>
    )
  }

  <CtaBand />
</Base>
