---
import Base from '~/layouts/Base.astro';
import Band from '~/components/Band.astro';
import Button from '~/components/Button.astro';
import Portrait from '~/components/Portrait.astro';
import Scramble from '~/components/Scramble.astro';
import Sterne from '~/components/Sterne.astro';
import ReviewBadge from '~/components/ReviewBadge.astro';
import Iphone from '~/components/Iphone.astro';
import Chat from '~/components/Chat.astro';
import Kanalkreise from '~/components/Kanalkreise.astro';
import Textrolle from '~/components/Textrolle.astro';
import Vormittag from '~/components/Vormittag.astro';
import {
  cta,
  services,
  address,
  owner,
  contactLinks,
  reviews,
} from '~/config/site';

const title = 'Elvora: Mehr Anfragen für Betriebe in Essen';
const description =
  'Website, Google-Sichtbarkeit und automatisierte Abläufe für Betriebe und Selbstständige in Essen und im Ruhrgebiet. Fester Ansprechpartner statt Agentur-Apparat.';

/** Wo Aufträge im Alltag verloren gehen. Konkret, nicht abstrakt. */
const verluste = [
  {
    titel: 'Das Telefon klingelt',
    text: 'Sie sind beim Kunden, im Termin, in der Werkstatt. Der Anrufer probiert den nächsten Betrieb. Sie erfahren nie davon.',
  },
  {
    titel: 'Zwölf Nachrichten am Abend',
    text: 'Dazu vier Rückrufwünsche. Sie arbeiten sie nach Feierabend ab, oder eben nicht.',
  },
  {
    titel: 'Niemand findet Sie',
    text: 'Gesucht wird bei Google, angerufen wird einer der ersten drei Treffer. Stehen Sie dort nicht, existieren Sie nicht.',
  },
];

/**
 * Was hereinkommt, während der Betrieb arbeitet.
 *
 * Zu jedem Ereignis gehört der Verlauf, der auf dem Telefon dazu abläuft.
 * Blickwinkel ist hier das Telefon des BETRIEBS: der Kunde steht links,
 * die Antwort der Assistenz rechts, weil sie über die eigene Nummer
 * hinausgeht.
 *
 * Die Namen sind Beispiele, keine echten Vorgänge.
 */
const vormittag = [
  {
    kanal: 'WhatsApp',
    zeit: '08:14',
    text: 'Terminanfrage vor Arbeitsbeginn. Beantwortet und eingetragen, ohne dass Sie das Telefon in die Hand genommen haben.',
    gespraech: {
      name: 'Frau Kern',
      status: 'zuletzt online 08:15',
      nachrichten: [
        { von: 'kunde' as const, zeit: '08:14', text: 'Guten Tag, ich bräuchte kurzfristig einen Termin. Geht diese Woche noch was?' },
        { von: 'assistenz' as const, zeit: '08:14', text: 'Guten Tag! Donnerstag 9:00 Uhr ist frei. Soll ich Sie eintragen?' },
        { von: 'kunde' as const, zeit: '08:15', text: 'Ja, gern.' },
        { von: 'assistenz' as const, zeit: '08:15', text: 'Eingetragen. Am Mittwoch kommt eine Erinnerung.' },
      ],
    },
  },
  {
    kanal: 'Verpasster Anruf',
    zeit: '09:02',
    text: 'Angerufen, niemand erreicht. Die Assistenz hat nachgefasst, das Anliegen aufgenommen und die Nummer notiert.',
    gespraech: {
      name: '0201 ••• ••••',
      status: 'nicht in den Kontakten',
      kuerzel: '?',
      nachrichten: [
        { von: 'assistenz' as const, zeit: '09:02', text: 'Guten Tag, Sie haben uns gerade angerufen und wir konnten leider nicht abnehmen. Worum geht es? Ich helfe Ihnen direkt hier weiter.' },
        { von: 'kunde' as const, zeit: '09:03', text: 'Ich bräuchte ein Angebot für eine Sanierung.' },
        { von: 'assistenz' as const, zeit: '09:03', text: 'Danke, ich habe Ihre Nummer notiert. Sie bekommen heute noch einen Rückruf.' },
      ],
    },
  },
  {
    kanal: 'Kontaktformular',
    zeit: '11:37',
    text: 'Anfrage über die Website. Eingang bestätigt, Rückruf für 16 Uhr vereinbart, alles ohne Ihr Zutun.',
    gespraech: {
      name: 'Familie Weber',
      status: 'zuletzt online 11:38',
      nachrichten: [
        { von: 'kunde' as const, zeit: '11:37', text: 'Guten Tag, ich habe eben das Formular auf Ihrer Website ausgefüllt. Ist das angekommen?' },
        { von: 'assistenz' as const, zeit: '11:37', text: 'Ja, Ihre Anfrage liegt vor. Passt Ihnen ein Rückruf heute um 16 Uhr?' },
        { von: 'kunde' as const, zeit: '11:38', text: 'Ja, perfekt.' },
        { von: 'assistenz' as const, zeit: '11:38', text: 'Notiert. Sie werden um 16 Uhr angerufen.' },
      ],
    },
  },
];

/**
 * Der Empfang, den man auf WhatsApp tatsächlich bekommt.
 *
 * Blickwinkel ist das Telefon des Interessenten: seine Nachrichten stehen
 * rechts, die der Assistenz links mit Profilbild.
 */
const empfang = [
  { von: 'kunde' as const, zeit: '9:41', text: 'Guten Tag, hätten Sie diese Woche noch einen Termin frei?' },
  { von: 'assistenz' as const, zeit: '9:41', text: 'Guten Tag! Ich bin die digitale Assistenz von Elvora. Worum geht es genau?' },
  { von: 'kunde' as const, zeit: '9:42', text: 'Wir bräuchten eine neue Website.' },
  { von: 'assistenz' as const, zeit: '9:42', text: 'Danke. Ich gebe das an Luan weiter, er meldet sich heute noch bei Ihnen.' },
];

const wege = [
  { label: 'WhatsApp', href: contactLinks.whatsapp, symbol: 'chat' as const, extern: true },
  { label: 'Telefon', href: contactLinks.tel, symbol: 'telefon' as const },
  { label: 'E-Mail', href: contactLinks.mail, symbol: 'brief' as const },
  { label: 'Termin', href: cta.primary.href, symbol: 'kalender' as const },
];
---

<Base title={title} description={description}>
  {/* ===================== Aufschlag =====================
      Zwei Spalten: links die Aussage, rechts die Vorfuehrung.

      Die Bewertungen stehen jetzt DIREKT UNTER DER UEBERSCHRIFT. Vorher
      sassen sie am Fuss der Hero und lagen auf einem Bildschirm mit 900
      Punkten Hoehe genau an der Kante. Ein Beleg, den man erst durch
      Scrollen findet, arbeitet nicht.

      Rechts laeuft der Verlauf, den man auf WhatsApp tatsaechlich bekommt.
      Er beginnt ohne Zutun, weil er beim Laden schon zu sehen ist. Damit
      steht die Vorfuehrung im ersten Blick und nicht erst nach dem halben
      Scrollweg. */}
  <section class="hero">
    <div class="container-content hero-inner">
      <div class="hero-text">
        <p class="hero-kennung kennung">
          <Scramble text={`Digitalagentur aus ${address.city} · Ruhrgebiet`} />
        </p>

        {/* Die Buchstaben klappen einzeln herein. Das ist der bewegte
            Moment im ersten Sichtbereich, und er sitzt auf dem Satz, auf
            den es ankommt, statt auf einer Zierleiste. */}
        <h1 class="hero-schlag">
          <Textrolle
            teile={[
              { text: 'Ihr Betrieb wird ' },
              { text: 'gefunden', betont: true },
              { text: ', angerufen und beauftragt.' },
            ]}
          />
        </h1>

        <ReviewBadge groesse="gross" class="hero-beleg" />

        <p class="hero-intro">
          Die meisten Betriebe verlieren Aufträge nicht an die Konkurrenz, sondern
          an verpasste Anrufe und eine Website, die niemand findet. Ich bringe
          beides in Ordnung.
        </p>

        <div class="hero-handlung">
          <Button href={cta.primary.href} size="lg" class="max-sm:w-full">
            {cta.primary.label}
          </Button>

          <a
            class="hero-neben"
            href={contactLinks.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            Oder direkt auf WhatsApp schreiben
            <svg
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.6"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M4 10h11M11 6l4 4-4 4" />
            </svg>
          </a>
        </div>

        <p class="hero-notiz">{cta.primary.note}</p>
      </div>

      <div class="hero-geraet">
        <Iphone bildunterschrift="Schematische Darstellung" breite="15rem">
          <Chat name="Elvora" status="online" nachrichten={empfang} uhrzeit="9:41" />
        </Iphone>

        <p class="hero-geraet-text">
          Auf WhatsApp antwortet zuerst meine KI-Assistenz. Dieselbe, die ich
          für Betriebe einrichte. Sie erleben sie aus der Kundenperspektive,
          statt sie sich vorstellen zu müssen.
        </p>
      </div>
    </div>
  </section>

  {/* ===================== Wo es klemmt ===================== */}
  <Band
    ton="gedaempft"
    kennung="Wo es klemmt"
    heading="Der Auftrag geht an den, der zuerst erreichbar war"
    intro="Nicht an den Besseren. Für einen Betrieb, in dem der Inhaber mitarbeitet, ist das eine unfaire Ausgangslage. Genau die lässt sich abstellen."
  >
    <ul class="verluste">
      {
        verluste.map((v, i) => (
          <li class="verlust einblenden" style={`--verzug:${i}`}>
            <p class="verlust-titel kennung">{v.titel}</p>
            <p class="verlust-text">{v.text}</p>
          </li>
        ))
      }
    </ul>
  </Band>

  {/* ===================== Die vier Leistungen ===================== */}
  <Band
    ton="hell"
    kennung="Leistungen"
    heading="Vier Bausteine, einzeln oder zusammen"
    intro="Sie müssen nicht alles auf einmal angehen. Meistens beginnen wir dort, wo gerade am meisten Geld liegen bleibt."
  >
    <ul class="leistungen">
      {
        services.map((service, i) => (
          <li class="leistung" style={`--farbe:${service.color}`}>
            <a class="leistung-link" href={service.href}>
              {/* Farbflaeche und Balken kommen beim Vorbeiscrollen herein.
                  Sie sind der Grund, warum sich die vier Zeilen ueberhaupt
                  voneinander unterscheiden. */}
              <span class="leistung-flaeche" aria-hidden="true" />
              <span class="leistung-balken" aria-hidden="true" />

              <span class="leistung-nummer ziffern einblenden" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>

              <span class="leistung-haupt einblenden" style="--verzug:1">
                <span class="leistung-label kennung">{service.label}</span>
                <span class="leistung-nutzen">{service.benefit}</span>
              </span>

              <span class="leistung-teaser einblenden" style="--verzug:2">
                {service.teaser}
              </span>

              <span class="leistung-pfeil" aria-hidden="true">
                <svg
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4 10h11M11 6l4 4-4 4" />
                </svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Band>

  {/* ===================== Was hereinkommt ===================== */}
  <Band
    ton="hell"
    kennung="Ein Vormittag"
    heading="So sieht ein Vormittag mit Assistenz aus"
    intro="Drei Anfragen, alle beantwortet, keine liegen geblieben. Sie waren in der Zeit bei Ihren Kunden."
  >
    <Vormittag ereignisse={vormittag} />
  </Band>

  {/* ===================== Der Mensch dahinter ===================== */}
  <Band ton="hell" kennung="Der Mensch dahinter" heading="Ich komme aus dem Handwerk">
    <div class="mensch">
      <div class="mensch-text">
        <p>
          Mein Name ist {owner.fullName}, gelernter {owner.trade}. Deshalb weiß
          ich, wie ein Betrieb von innen aussieht: Der Inhaber arbeitet mit, das
          Telefon klingelt zur Unzeit, und der Papierkram bleibt für abends
          übrig. Ob Werkstatt, Praxis oder Kanzlei ändert daran wenig.
        </p>
        <p>
          Sie haben mit mir zu tun, nicht mit einem Team. Wer das Angebot macht,
          macht auch die Arbeit und geht ans Telefon.
        </p>

        <a class="mensch-weiter" href="/ueber-mich/">
          Mehr über mich
          <svg
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 10h11M11 6l4 4-4 4" />
          </svg>
        </a>
      </div>

      <div class="mensch-bild hereinziehen">
        <Portrait alt={`${owner.fullName}, Inhaber von Elvora aus ${address.city}`} />
      </div>
    </div>
  </Band>

  {/* ===================== Bewertungen ===================== */}
  {
    reviews.enabled && reviews.items.length > 0 && (
      <Band ton="gedaempft" kennung="Was Kunden sagen" heading="Bewertungen">
        <ul class="stimmen">
          {reviews.items.map((stimme, i) => (
            <li class="stimme einblenden" style={`--verzug:${i}`}>
              <Sterne wert={stimme.rating} groesse={1} />
              <p class="stimme-text">{stimme.text}</p>
              <p class="stimme-quelle">
                <span class="stimme-name">{stimme.author}</span>
                {stimme.business && <span class="stimme-betrieb">{stimme.business}</span>}
              </p>
            </li>
          ))}
        </ul>
      </Band>
    )
  }

  {/* ===================== Abschluss =====================
      Die einzige dunkle Flaeche der Seite. Genau deshalb faellt sie auf. */}
  <Band ton="tief" kennung="Loslegen" heading="Klingt das nach Ihrem Betrieb?">
    <div class="schluss">
      <div class="schluss-text">
        <p>
          In einem kurzen Gespräch schauen wir, wo bei Ihnen gerade Anfragen
          verloren gehen. Ohne Vorbereitung, ohne Verpflichtung. Und wenn ich
          Ihnen nicht helfen kann, sage ich Ihnen das.
        </p>

        <div class="schluss-wege">
          <p class="schluss-wege-titel kennung">Alle Wege zu mir</p>
          <Kanalkreise kanaele={wege} tone="inverse" />
        </div>
      </div>

      <div class="schluss-handlung">
        <Button href={cta.primary.href} size="lg" variant="aufFarbe" class="max-sm:w-full">
          {cta.primary.label}
        </Button>
        <p class="schluss-notiz">{cta.primary.note}</p>
      </div>
    </div>
  </Band>
</Base>

<style>
  /* ===================== Aufschlag ===================== */
  .hero {
    background: var(--color-surface);
  }

  .hero-inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 5.5rem);
  }

  /* Zwei Spalten erst, wenn beides nebeneinander wirklich Platz hat. Frueher
     waere das Geraet ein Streifen und die Zeile im Text vier Woerter breit. */
  @media (width >= 64rem) {
    .hero-inner {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      align-items: center;
    }
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(1.125rem, 2vw, 1.5rem);
  }

  .hero-kennung {
    margin: 0;
    color: var(--color-ink-faint);
  }

  /* Die Groesse traegt hier alles. Instrument Serif hat keinen Fettschnitt,
     die Wirkung kommt aus Mass und Satz.

     Kleiner als in der einspaltigen Fassung: neben dem Geraet steht weniger
     Breite zur Verfuegung, und der Aufruf muss ohne Scrollen zu sehen sein. */
  .hero-schlag {
    margin: 0;
    font-size: clamp(2.375rem, 4.6vw, 3.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    /* Etwas mehr als vorher: die Buchstaben der Textrolle sind eigene
       Kaestchen, dadurch bauen die Woerter minimal breiter und der Satz
       brach eine Zeile zu frueh um. */
    max-width: 18ch;
  }

  /* Ein einziges Wort kursiv und in der Markenfarbe. Instrument Serif hat
     einen sehr schoenen Kursivschnitt, und ein Akzent wirkt nur, wenn er
     allein steht. Ausgezeichnet wird es in der Textrolle ueber `betont`. */

  .hero-intro {
    margin: 0;
    max-width: 44ch;
    font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .hero-handlung {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem 1.75rem;
    margin-top: clamp(0.25rem, 1vw, 0.5rem);
  }

  /* Der zweite Weg bleibt ein Textlink: flaechig waere er ein zweiter
     Haupt-CTA und wuerde dem ersten die Wirkung nehmen. */
  .hero-neben {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink-muted);
    font-size: 0.9375rem;
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 5px;
    transition: color 0.15s, text-decoration-color 0.15s;
  }

  .hero-neben:hover {
    color: var(--color-ink);
    text-decoration-color: var(--color-ink-faint);
  }

  .hero-neben svg {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  .hero-neben:hover svg {
    transform: translateX(3px);
  }

  .hero-notiz {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-ink-faint);
  }

  /* --- Die Vorfuehrung im ersten Sichtbereich --------------------------- */
  .hero-geraet {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .hero-geraet-text {
    margin: 0;
    max-width: 30ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    text-align: center;
    color: var(--color-ink-muted);
  }

  @media (width >= 64rem) {
    .hero-geraet {
      align-items: flex-end;
    }

    .hero-geraet-text {
      text-align: end;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-kennung,
    .hero-beleg,
    .hero-intro,
    .hero-handlung,
    .hero-notiz,
    .hero-geraet {
      animation: aufsteigen 0.8s cubic-bezier(0.22, 1, 0.36, 1) backwards;
    }
    .hero-kennung { animation-delay: 0.05s; }
    /* Der Beleg kommt frueh, nicht zuletzt: er soll beim ersten Blick da
       sein und nicht nachtroepfeln. */
    .hero-beleg { animation-delay: 0.26s; }
    .hero-intro { animation-delay: 0.34s; }
    .hero-handlung { animation-delay: 0.42s; }
    .hero-notiz { animation-delay: 0.48s; }
    .hero-geraet { animation-delay: 0.3s; }
  }

  @keyframes aufsteigen {
    from { opacity: 0; transform: translateY(1rem); }
    to { opacity: 1; transform: none; }
  }

  /* ===================== Wo es klemmt ===================== */
  .verluste {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 48rem) {
    .verluste {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: clamp(2rem, 3.5vw, 3.5rem);
    }

    .verlust {
      padding-inline-start: clamp(1.25rem, 2vw, 2rem);
      border-inline-start: 1px solid var(--color-border);
    }

    .verlust:first-child {
      padding-inline-start: 0;
      border-inline-start: 0;
    }
  }

  @media (width < 48rem) {
    .verlust + .verlust {
      padding-top: 1.75rem;
      border-top: 1px solid var(--color-border);
    }
  }

  .verlust-titel {
    margin: 0 0 0.625rem;
    color: var(--color-accent);
  }

  .verlust-text {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  /* ===================== Leistungen =====================
     Vorher: vier fast gleiche Textbloecke untereinander, alle mit derselben
     magentafarbenen Kennung, rechts daneben eine leere halbe Seite. Das las
     sich als Wand und wurde ueberflogen.

     Jetzt traegt jede Leistung IHRE Farbe, die Zeile nutzt die volle Breite,
     und beim Vorbeiscrollen faehrt die Farbe herein. Damit hat jede der vier
     einen eigenen Auftritt statt eines Platzes in einer Liste. */
  .leistungen {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .leistung {
    border-block-start: 1px solid var(--color-border);
  }

  .leistung:last-child {
    border-block-end: 1px solid var(--color-border);
  }

  .leistung-link {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 0.5rem 2rem;
    padding: clamp(1.75rem, 3.5vw, 2.75rem) clamp(0.875rem, 2vw, 1.75rem);
    text-decoration: none;
    color: inherit;
  }

  /* Auf breiten Schirmen laeuft die Zeile ueber die ganze Breite: Nummer,
     Nutzen, Erklaerung, Pfeil. Vorher blieb rechts ein Drittel leer. */
  @media (width >= 62rem) {
    .leistung-link {
      grid-template-columns: 3.75rem minmax(0, 1.05fr) minmax(0, 0.95fr) 2.75rem;
      align-items: center;
    }
  }

  /* Ein Hauch der Leistungsfarbe, von links hereinlaufend. Nur ein Hauch:
     vier volle Farbflaechen untereinander waeren ein Farbkasten. */
  .leistung-flaeche {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to right,
      color-mix(in oklab, var(--farbe) 15%, transparent),
      color-mix(in oklab, var(--farbe) 5%, transparent) 50%,
      transparent 88%
    );
    opacity: 0;
  }

  .leistung-balken {
    position: absolute;
    inset-block: 0;
    inset-inline-start: 0;
    z-index: -1;
    width: 4px;
    background: var(--farbe);
    transform-origin: top;
    scale: 1 0;
  }

  /* Gross und in der Farbe der Leistung. Vorher stand hier eine 12 Punkt
     kleine graue Ziffer, die nichts gegliedert hat. Jetzt ist sie der
     Anker, an dem das Auge beim Scrollen haengen bleibt. */
  .leistung-nummer {
    font-size: clamp(1.5rem, 2.6vw, 2.125rem);
    line-height: 1;
    color: var(--farbe);
  }

  .leistung-haupt {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    min-width: 0;
  }

  /* Die Kennung in der Farbe der Leistung statt viermal in derselben. Alle
     vier Farben halten auf Weiss die 4,5:1 nach WCAG AA. */
  .leistung-label {
