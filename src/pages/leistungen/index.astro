---
import Base from '~/layouts/Base.astro';
import PanelHero from '~/components/PanelHero.astro';
import Band from '~/components/Band.astro';
import CtaBand from '~/components/CtaBand.astro';
import { services, automationModules, serviceArea } from '~/config/site';
---

<Base
 
  title="Leistungen für Betriebe in Essen"
  description="Webdesign, lokale Suchmaschinenoptimierung, Branding und KI-Automatisierung für Betriebe und Selbstständige in Essen und im Ruhrgebiet."
  breadcrumbs={[{ label: 'Leistungen' }]}
>
  <PanelHero
    eyebrow="Leistungen"
    heading="Vier Bausteine gegen die vier häufigsten Engpässe"
    intro="Sie müssen nicht alles auf einmal angehen. Meistens beginnen wir dort, wo gerade am meisten Geld liegen bleibt, und bauen von da aus weiter."
    color="#2b2f7a"
    breadcrumbs={[{ label: 'Leistungen' }]}
  />

  <Band ton="hell">
    <ul class="leistungen">
      {
        services.map((service, i) => (
          <li class="leistung einblenden" style={`--verzug:${i};--farbe:${service.color}`}>
            <a class="leistung-link" href={service.href}>
              <span class="leistung-nummer ziffern" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>

              <span class="leistung-text">
                <span class="leistung-label kennung">{service.label}</span>
                <span class="leistung-nutzen">{service.benefit}</span>
                <span class="leistung-teaser">{service.teaser}</span>
                {service.slug === 'automatisierung' && (
                  <span class="leistung-zusatz kennung">
                    {automationModules.length} einsatzbereite Module
                  </span>
                )}
              </span>

              <svg
                class="leistung-pfeil"
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M4 10h11M11 6l4 4-4 4" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </Band>

  <Band ton="gedaempft" raum="md">
    <p class="gebiet">Betreut werden Betriebe in {serviceArea.display}.</p>
  </Band>

  <CtaBand />
</Base>

<style>
  /* Zeilen mit Haarlinien statt Farbstreifen. Die Farbe der Leistung bleibt
     als schmale Kante links erhalten -- gerade genug, um Uebersicht,
     Startseite und Detailseite zusammenzuhalten. */
  .leistungen {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .leistung {
    border-top: 1px solid var(--color-border);
  }

  .leistung:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .leistung-link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.875rem 1.25rem;
    padding-block: clamp(1.75rem, 3.5vw, 2.75rem);
    color: inherit;
    text-decoration: none;
    border-inline-start: 3px solid transparent;
    padding-inline-start: 1rem;
    transition: border-color 0.25s, padding-inline-start 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (width >= 48rem) {
    .leistung-link {
      gap: 1rem 2.5rem;
    }

    .leistung-link:hover {
      border-inline-start-color: var(--farbe);
      padding-inline-start: 1.75rem;
    }
  }

  .leistung-nummer {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--color-ink-faint);
  }

  .leistung-text {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .leistung-label {
    color: var(--farbe);
  }

  .leistung-nutzen {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.12;
    letter-spacing: -0.015em;
    max-width: 20ch;
  }

  .leistung-teaser {
    max-width: 52ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

  .leistung-zusatz {
    color: var(--color-ink-faint);
  }

  .leistung-pfeil {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    color: var(--color-ink-faint);
    transition: transform 0.2s, color 0.2s;
  }

  .leistung-link:hover .leistung-pfeil {
    transform: translateX(4px);
    color: var(--farbe);
  }

  .gebiet {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--color-ink-muted);
  }
</style>
