---
/**
 * Die Kontaktwege als aufklappende Symbolknöpfe, nach der Vorlage des
 * Download-Knopfs: in Ruhe ein Kreis mit Zeichen, beim Zeigen fährt er
 * auf und der Name erscheint, während die übrigen zurücktreten.
 *
 * ABWEICHUNGEN VON DER VORLAGE
 *
 * 1. Kein React, kein framer-motion. Das Auffahren ist ein
 *    max-width-Übergang, das Zurücktreten der anderen eine
 *    :has()-Regel. Null JavaScript, wie überall auf der Seite.
 *
 * 2. Auf Geräten ohne Mauszeiger gibt es kein Zeigen: dort stehen alle
 *    Knöpfe von vornherein aufgeklappt mit Namen da. Ein Kreis, der sein
 *    Geheimnis erst beim Überfahren preisgibt, wäre auf dem Handy ein
 *    Ratespiel.
 *
 * 3. Tastatur zählt wie Zeigen: der fokussierte Knopf klappt auf.
 */
type Symbolname = 'chat' | 'telefon' | 'brief' | 'kalender';

const symbole: Record<Symbolname, string> = {
  chat: 'M10 2a8 8 0 0 0-6.9 12.03L2 18l4.07-1.06A8 8 0 1 0 10 2z',
  telefon:
    'M6.6 3.2 4.3 4.4a1.6 1.6 0 0 0-.8 1.9c.9 3 2.4 5.3 4.5 7 2 1.7 4 2.6 6 2.7a1.6 1.6 0 0 0 1.6-1.1l.7-2.4-3.4-1.5-1.3 1.6a11 11 0 0 1-4-3.9l1.7-1.2-2.7-4.3z',
  brief: 'M2.5 5.5h15v9h-15zM2.5 6l7.5 5 7.5-5',
  kalender: 'M3.5 5.5h13v11h-13zM3.5 9h13M7 3.5v3M13 3.5v3',
};

interface Props {
  kanaele: Array<{ label: string; href: string; symbol: Symbolname; extern?: boolean }>;
  /** `inverse` für farbige Flächen. */
  tone?: 'light' | 'inverse';
  class?: string;
}

const { kanaele, tone = 'light', class: className = '' }: Props = Astro.props;
---

<ul class:list={['wege', tone === 'inverse' && 'wege-invers', className]}>
  {
    kanaele.map((kanal) => (
      <li>
        <a
          class="weg"
          href={kanal.href}
          {...(kanal.extern ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          aria-label={kanal.label}
        >
          <span class="weg-symbol" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill={kanal.symbol === 'chat' ? 'currentColor' : 'none'}
              stroke={kanal.symbol === 'chat' ? 'none' : 'currentColor'}
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={symbole[kanal.symbol]} />
            </svg>
          </span>
          <span class="weg-text" aria-hidden="true">{kanal.label}</span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .wege {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .weg {
    display: inline-flex;
    align-items: center;
    height: 3.25rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink);
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.25s, background 0.25s, opacity 0.3s, transform 0.3s;
  }

  .weg-symbol {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.25rem;
    height: 3.25rem;
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .weg-symbol svg {
    width: 1.35rem;
    height: 1.35rem;
  }

  .weg-text {
    font-size: 0.9375rem;
    font-weight: 500;
    white-space: nowrap;
  }

  /* --- Nur mit Mauszeiger: eingeklappt, faehrt beim Zeigen auf ---------- */
  @media (hover: hover) {
    .weg-text {
      max-width: 0;
      padding-inline-end: 0;
      opacity: 0;
      transition:
        max-width 0.38s cubic-bezier(0.22, 1, 0.36, 1),
        padding 0.38s cubic-bezier(0.22, 1, 0.36, 1),
        opacity 0.2s;
    }

    .weg:hover .weg-text,
    .weg:focus-visible .weg-text {
      max-width: 12rem;
      padding-inline-end: 1.25rem;
      opacity: 1;
      transition:
        max-width 0.38s cubic-bezier(0.22, 1, 0.36, 1),
        padding 0.38s cubic-bezier(0.22, 1, 0.36, 1),
        opacity 0.25s 0.1s;
    }

    .weg:hover,
    .weg:focus-visible {
      border-color: var(--color-accent);
      background: var(--color-accent-soft);
    }

    /* Die anderen treten zurueck, waehrend einer auffaehrt. */
    .wege:has(.weg:hover) .weg:not(:hover),
    .wege:has(.weg:focus-visible) .weg:not(:focus-visible) {
      opacity: 0.45;
      transform: scale(0.92);
    }
  }

  /* Ohne Mauszeiger stehen die Namen immer da. */
  @media (hover: none) {
    .weg-text {
      padding-inline-end: 1.25rem;
    }
  }

  /* --- Auf dunkler Flaeche ---------------------------------------------- */
  .wege-invers .weg {
    border-color: rgb(255 255 255 / 0.28);
    background: rgb(255 255 255 / 0.07);
    color: #fff;
  }

  .wege-invers .weg-symbol {
    color: #fff;
  }

  @media (hover: hover) {
    .wege-invers .weg:hover,
    .wege-invers .weg:focus-visible {
      border-color: rgb(255 255 255 / 0.6);
      background: rgb(255 255 255 / 0.16);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .weg,
    .weg-text {
      transition: none;
    }
  }
</style>
