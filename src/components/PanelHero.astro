---
import Breadcrumbs from './Breadcrumbs.astro';
import Scramble from './Scramble.astro';

/**
 * Vollflächige Farbtafel als Kopfbereich.
 *
 * Die durchgehende Bildsprache der Seite: kräftige Fläche, Nummer oder
 * Kennzeichnung darüber, Linien als Gliederung, sehr große Überschrift.
 * Dieselben Farben tragen die gestapelten Flächen auf der Startseite,
 * dadurch gehören Übersicht und Detailseite sichtbar zusammen.
 */
interface Props {
  /** Kleine Kennzeichnung über der Überschrift. */
  eyebrow: string;
  /** Die H1. Bewusst als Nutzenaussage formuliert, nicht als Fachbegriff. */
  heading: string;
  /** Ein bis zwei Sätze darunter. */
  intro?: string;
  /** Hintergrundfarbe der Tafel. */
  color?: string;
  breadcrumbs?: Array<{ label: string; href?: string }>;
  /** `gross` für Leistungsseiten, `kompakt` für Rechtstexte und Nebenseiten. */
  size?: 'gross' | 'kompakt';
  class?: string;
}

const {
  eyebrow,
  heading,
  intro,
  color = '#1d2140',
  breadcrumbs = [],
  size = 'gross',
  class: className = '',
}: Props = Astro.props;
---

<section
  class:list={['tafel', size === 'kompakt' && 'tafel-kompakt', className]}
  style={`--grund:${color}`}
>
  <div class="container-content tafel-inner">
    {breadcrumbs.length > 0 && <Breadcrumbs trail={breadcrumbs} />}

    <p class="tafel-eyebrow kennung"><Scramble text={eyebrow} /></p>

    {/* Genau eine Linie, unter der Kennung. Eine zweite unter der
        Schlagzeile rahmte die Aussage ein wie ein Formularfeld. */}
    <hr />

    <h1 class="tafel-schlag">{heading}</h1>

    {intro && <p class="tafel-intro">{intro}</p>}

    <slot />
  </div>
</section>

<style>
  /* Heller Kopf statt Farbtafel. Die Seitenfarbe bleibt erhalten, aber nur
     noch als schmale Kante oben und in der Kennung -- gerade genug, damit
     Leistungsseite und Uebersicht sichtbar zusammengehoeren, ohne dass die
     ganze Flaeche zugeschuettet wird. */
  .tafel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--color-surface);
    color: var(--color-ink);
  }

  .tafel-inner {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-block: clamp(2.25rem, 5vw, 3.5rem) clamp(2.5rem, 5vw, 3.5rem);
  }

  .tafel-kompakt .tafel-inner {
    padding-block: clamp(2rem, 4vw, 3rem) clamp(2.5rem, 5vw, 3.5rem);
  }

  .tafel-eyebrow {
    margin: 0;
    color: var(--grund);
  }

  .tafel hr {
    margin: 0;
    border: 0;
    border-top: 1px solid var(--color-border);
  }

  /* Zeilenhoehe ueber 1.0, sonst stossen die Punkte von Ae, Oe und Ue in
     die Zeile darueber. Betrifft hier zum Beispiel "Ueber mich". */
  .tafel-schlag {
    margin: 0;
    color: var(--color-ink);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.015em;
    max-width: 20ch;
  }

  .tafel-kompakt .tafel-schlag {
    font-size: clamp(1.875rem, 3.8vw, 2.75rem);
  }

  .tafel-intro {
    margin: 0;
    max-width: 52ch;
    font-size: clamp(1.0625rem, 1.6vw, 1.3125rem);
    line-height: 1.6;
    color: var(--color-ink-muted);
  }

</style>
